# caches / build
__pycache__/
*.pyc
# deploy backups + local backups
*.bak
*.bak-*
# secrets — never commit
*secret*
*password*.txt
board.conf
guest.conf
# runtime data / user content
data/
uploads/
tmp/
slideshow-cache/
*.pcap
*.pcapng
*.cap
# large media captures
/mnt/
# Obsidian per-machine / churny state -- track the notes and shared config,
# ignore the workspace layout, caches, and trash.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/
