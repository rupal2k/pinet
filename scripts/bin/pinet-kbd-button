#!/usr/bin/env python3
"""Floating 'pull the keyboard down' button for PINET (GTK3 + wlr layer-shell).
Owns the on-screen keyboard: starts wvkbd as its child, shows a pull-down tab
sitting on the keyboard's top edge at the right, and exits when the keyboard
goes away. Tap = close the keyboard. Started by `pinet-kbd show` (the taskbar
keyboard icon); the lock keeps it to one instance."""
import fcntl
import os
import signal
import sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, GtkLayerShell, Gdk, GLib

LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()),
                    "pinet-kbd.lock")
lock = open(LOCK, "a+")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit(0)  # a keyboard is already open or opening
lock.truncate(0); lock.write(str(os.getpid())); lock.flush()

KBD_HEIGHT = 215  # px, landscape; the tab stands on the keyboard's top edge

# Desktop colours (labwc theme): panel #14161a, key #1e2128, edge #2c303a,
# text #eef0f3 / muted #9198a3, the active-border gold as the pressed key.
WVKBD = ["wvkbd-mobintl", "-L", str(KBD_HEIGHT), "-R", "9", "--fn", "Sans 17",
         "--landscape-layers", "landscape,landscapespecial,emoji",
         "--bg", "14161aff", "--fg", "1e2128ff", "--fg-sp", "2c303aff",
         "--text", "eef0f3ff", "--text-sp", "9198a3ff",
         "--press", "f2c14eff", "--press-sp", "f2c14eff"]

CSS = b"""
window { background: transparent; }
button {
  background: #1e2128;
  color: #eef0f3;
  border: 1px solid #2c303a;
  border-bottom: none;
  border-radius: 10px 10px 0 0;
  box-shadow: none;
  margin: 0; padding: 0;
  font-size: 22px;
  font-weight: bold;
}
button:active { background: #f2c14e; color: #14161a; }
"""

win = Gtk.Window()
win.set_decorated(False)
GtkLayerShell.init_for_window(win)
GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
# Bottom-right, standing on the keyboard's top edge, so it covers only the
# tail of the last terminal line. Exclusive zone -1 = measure from the screen
# edge, not from above the (hidden) taskbar's reserved strip.
GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
GtkLayerShell.set_exclusive_zone(win, -1)
GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, KBD_HEIGHT)
GtkLayerShell.set_margin(win, GtkLayerShell.Edge.RIGHT, 10)
GtkLayerShell.set_namespace(win, "pinet-kbd-button")

prov = Gtk.CssProvider(); prov.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

btn = Gtk.Button(label="⌄")   # pull the keyboard down
btn.set_size_request(64, 30)
pid, *_ = GLib.spawn_async(WVKBD, flags=GLib.SpawnFlags.SEARCH_PATH
                            | GLib.SpawnFlags.DO_NOT_REAP_CHILD)
GLib.child_watch_add(pid, lambda *_: Gtk.main_quit())  # keyboard gone -> exit
btn.connect("clicked", lambda *_: os.kill(pid, signal.SIGTERM))
win.add(btn)
win.show_all()
Gtk.main()
