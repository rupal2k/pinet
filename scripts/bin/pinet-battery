#!/usr/bin/env python3
"""Battery level of the Waveshare UPS HAT (D) in the taskbar.

The panel's own battery widget only reads /sys/class/power_supply, and the
HAT is just an INA219 on I2C, so this puts a StatusNotifierItem in the
panel's tray instead. Its icons are pinet-battery-<0..100 step 10>[-charging]
from ~/.local/share/icons: a phone-style pill filled to the level in 10%
steps, bolt inside while on mains, in the PINET theme's colours.
The tooltip has the percentage, voltage and current.

    pinet-battery          run the tray icon (the user service does this)
    pinet-battery --once   print one reading and exit (for a quick check by hand)
    pinet-battery --log F  append one CSV line a minute to F, for calibrating
                           OCV_CURVE from a full discharge (pinet-battery-log)

The e-ink dashboard and pinet-ups-guard import this file as a module (read,
find, percent, rest_volts, power_state, remaining_mah, LABELS, SMOOTH...), so
the maths lives here once; keep those names stable.

Knobs (environment) for a HAT that reads differently from the Waveshare demo:
    UPS_I2C_BUS=1  UPS_ADDR=0x43  UPS_SHUNT_OHMS=0.01
    UPS_CURRENT_SIGN=-1   HAT (D) reads negative while charging: measured
                          3.57 V / +0.9 A unplugged, 3.74 V / -2.2 A plugged in
    >5 V on the bus means 2 cells in series (percent works per cell)
    UPS_CAPACITY_MAH=8400   two 21700 4200 mAh cells in parallel
    UPS_INTERNAL_OHMS=0.045  pack + wiring resistance, measured by pulling the
                          charger: 3.764 V @ +2.19 A -> 3.640 V @ -0.51 A
                          (0.046 ohm), and back: 0.042 ohm
"""
import os
import sys

BUS = int(os.environ.get("UPS_I2C_BUS", "1"))
ADDRS = [int(os.environ["UPS_ADDR"], 0)] if "UPS_ADDR" in os.environ else [0x43, 0x42, 0x41, 0x40]
SHUNT_OHMS = float(os.environ.get("UPS_SHUNT_OHMS", "0.01"))
CURRENT_SIGN = float(os.environ.get("UPS_CURRENT_SIGN", "-1"))
# Resting cell voltage -> charge, for 3.6 V-nominal NMC 21700 cells. Li-ion
# is flat through the middle and steep at both ends, so a straight 3.0-4.2 V
# line read ~10% high mid-range.
# ponytail: a generic curve, not these exact cells; log rest_volts over one
# full discharge and replace the points to calibrate it.
OCV_CURVE = ((3.00, 0), (3.30, 5), (3.45, 10), (3.55, 20), (3.62, 30), (3.68, 40),
             (3.74, 50), (3.80, 60), (3.87, 70), (3.95, 80), (4.06, 90), (4.20, 100))
CAPACITY_MAH = int(os.environ.get("UPS_CAPACITY_MAH", "8400"))
INTERNAL_OHMS = float(os.environ.get("UPS_INTERNAL_OHMS", "0.045"))
CHARGING_A = 0.02          # current into the cells above this counts as charging
INTERVAL = 5               # seconds between readings
# Smoothing over SMOOTH readings hides what load jitter rest_volts leaves.
SMOOTH = 6
ICON_DIR = os.path.expanduser(os.environ.get("ICON_DIR", "~/.local/share/icons"))


def rest_volts(volts, amps):
    """What the cells would read with no current flowing. Charging current
    lifts the terminal voltage and the Pi's load sags it (I x R), which made
    the same charge read 66% on the charger and 54% off it."""
    return volts - amps * INTERNAL_OHMS


def percent(volts):
    """Charge (0-100) for a resting voltage, by interpolating OCV_CURVE."""
    v = volts / (2 if volts > 5.0 else 1)
    if v <= OCV_CURVE[0][0]:
        return 0
    for (v0, p0), (v1, p1) in zip(OCV_CURVE, OCV_CURVE[1:]):
        if v <= v1:
            return round(p0 + (p1 - p0) * (v - v0) / (v1 - v0))
    return 100


def remaining_mah(pct):
    """Charge left, estimated from the percent: the HAT has no fuel gauge."""
    return round(CAPACITY_MAH * pct / 100 / 10) * 10


def power_state(amps):
    """charging, battery (running on it) or full (on mains, nothing flowing)."""
    if amps > CHARGING_A:
        return "charging"
    if amps < -CHARGING_A:
        return "battery"
    return "full"


# "full" = next to no current either way: the Pi runs on external power --
# its own micro-USB supply with the HAT switched off, or the HAT's charger with
# the cells full. The INA219 only sees the cells, so it can't tell those two
# apart; both are "External power", shown with a plug.
LABELS = {"charging": "Charging", "battery": "On battery", "full": "External power"}


UNKNOWN_ICON = "pinet-battery-unknown"   # dim outline: no reading (yet)
PLUG_ICON = "pinet-power-plug"           # external power (state "full")
READ_FAILURES_SHOWN = 3   # failed reads in a row before the tray admits it has no reading


def icon_name(pct, state):
    """The plug on external power, the bolt while charging, else the level."""
    if state == "full":
        return PLUG_ICON
    return f"pinet-battery-{round(pct / 10) * 10}" + ("-charging" if state == "charging" else "")


LOG_SECONDS = 60
# ponytail: trims to the newest LOG_KEEP lines (~1 week at 1/min), rewriting the
# file when it passes LOG_KEEP * 1.25; a discharge takes hours, so a week is plenty.
LOG_KEEP = 10080


def log_line(t, volts, amps):
    rv = rest_volts(volts, amps)
    return f"{t:%Y-%m-%dT%H:%M:%S},{volts:.3f},{amps:+.3f},{rv:.3f},{percent(rv)},{power_state(amps)}\n"


def log_forever(bus, addr, path):
    """Calibration log: one reading a minute, CSV. Log a full discharge on
    battery (charger out, from ~100% to the guard's shutdown); the resting
    voltage against time is what OCV_CURVE should be fitted to."""
    import datetime
    import time
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if not os.path.exists(path):
        with open(path, "w") as f:
            f.write("time,volts,amps,rest_volts,percent,state\n")
    while True:
        try:
            volts, amps = read(bus, addr)
            if volts >= 2.5:                 # a bad read, not a flat cell
                with open(path, "a") as f:
                    f.write(log_line(datetime.datetime.now(), volts, amps))
                with open(path) as f:
                    lines = f.readlines()
                if len(lines) > LOG_KEEP * 1.25:
                    with open(path, "w") as f:
                        f.writelines(lines[:1] + lines[-LOG_KEEP:])
        except OSError as e:
            print(f"pinet-battery: log read failed: {e}", file=sys.stderr)
        time.sleep(LOG_SECONDS)


def read(bus, addr):
    """(bus volts, amps into the cells) straight from the INA219 registers.
    Needs no calibration write: shunt volts / shunt ohms is the current."""
    def word(reg):
        v = bus.read_word_data(addr, reg)
        return ((v & 0xFF) << 8) | (v >> 8)   # the INA219 is big-endian
    volts = (word(0x02) >> 3) * 0.004
    shunt = word(0x01)
    if shunt & 0x8000:
        shunt -= 0x10000
    return volts, CURRENT_SIGN * shunt * 10e-6 / SHUNT_OHMS


def find(bus):
    for addr in ADDRS:
        try:
            volts, _ = read(bus, addr)
        except OSError:
            continue
        if volts > 2.5:          # a real cell, not some other chip answering
            return addr
    return None


SNI_XML = """<node><interface name="org.kde.StatusNotifierItem">
<property name="Category" type="s" access="read"/>
<property name="Id" type="s" access="read"/>
<property name="Title" type="s" access="read"/>
<property name="Status" type="s" access="read"/>
<property name="IconName" type="s" access="read"/>
<property name="IconThemePath" type="s" access="read"/>
<property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
<property name="ItemIsMenu" type="b" access="read"/>
<method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<signal name="NewIcon"/><signal name="NewToolTip"/><signal name="NewTitle"/>
</interface></node>"""


def tray(bus, addr):
    from gi.repository import Gio, GLib

    # No reading yet: say so, rather than start out claiming a full battery.
    state = {"icon": UNKNOWN_ICON, "tip": "Battery: reading\u2026", "volts": [], "failures": 0}
    conn = Gio.bus_get_sync(Gio.BusType.SESSION)
    name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
    path = "/StatusNotifierItem"

    def get_prop(_c, _s, _p, _i, prop):
        return {
            "Category": GLib.Variant("s", "Hardware"),
            "Id": GLib.Variant("s", "pinet-battery"),
            "Title": GLib.Variant("s", state["tip"].split("\n")[0]),
            "Status": GLib.Variant("s", "Active"),
            "IconName": GLib.Variant("s", state["icon"]),
            "IconThemePath": GLib.Variant("s", ICON_DIR),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (state["icon"], [], "Battery", state["tip"])),
            "ItemIsMenu": GLib.Variant("b", False),
        }.get(prop)

    def call(_c, _s, _p, _i, _m, _args, invocation):
        invocation.return_value(None)    # a click does nothing; the tooltip says it all

    iface = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
    conn.register_object(path, iface, call, get_prop, None)
    Gio.bus_own_name_on_connection(conn, name, Gio.BusNameOwnerFlags.NONE, None, None)

    def register(*_):
        # Again every time the panel (the watcher) comes back after a respawn.
        conn.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                  "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
                  GLib.Variant("(s)", (name,)), None, Gio.DBusCallFlags.NONE, -1, None, None)
    Gio.bus_watch_name_on_connection(conn, "org.kde.StatusNotifierWatcher",
                                     Gio.BusNameWatcherFlags.NONE, register, None)

    def update():
        try:
            volts, amps = read(bus, addr)
            if volts < 2.5:
                raise OSError(f"implausible reading {volts:.2f} V")   # a bad read, not a flat cell
        except OSError as e:
            print(f"pinet-battery: read failed: {e}", file=sys.stderr)
            state["failures"] += 1
            # A glitch keeps the last reading; a run of failures stops the
            # tray from showing a level it is no longer measuring.
            if state["failures"] < READ_FAILURES_SHOWN:
                return True
            icon, tip = UNKNOWN_ICON, "Battery: no reading from the UPS HAT"
            state["volts"] = []
        else:
            state["failures"] = 0
            state["volts"] = (state["volts"] + [rest_volts(volts, amps)])[-SMOOTH:]
            pct = percent(sum(state["volts"]) / len(state["volts"]))
            ps = power_state(amps)
            icon = icon_name(pct, ps)
            tip = f"{pct}%  {LABELS[ps]}\n~{remaining_mah(pct)} / {CAPACITY_MAH} mAh" \
                  f"\n{volts:.2f} V  {amps * 1000:+.0f} mA"
        if icon != state["icon"]:
            state["icon"] = icon
            conn.emit_signal(None, path, "org.kde.StatusNotifierItem", "NewIcon", None)
        if tip != state["tip"]:
            state["tip"] = tip
            conn.emit_signal(None, path, "org.kde.StatusNotifierItem", "NewToolTip", None)
            conn.emit_signal(None, path, "org.kde.StatusNotifierItem", "NewTitle", None)
        return True

    update()
    GLib.timeout_add_seconds(INTERVAL, update)
    GLib.MainLoop().run()


def main():
    from smbus2 import SMBus
    bus = SMBus(BUS)
    addr = find(bus)
    if addr is None:
        sys.exit(f"pinet-battery: no UPS HAT (INA219) at {', '.join(hex(a) for a in ADDRS)} on i2c-{BUS}")
    if sys.argv[1:] == ["--once"]:
        # key=value, one line
        volts, amps = read(bus, addr)
        state = power_state(amps)
        pct = percent(rest_volts(volts, amps))
        print(f"addr={addr:#x} volts={volts:.3f} amps={amps:+.3f} percent={pct} "
              f"mah={remaining_mah(pct)} capacity_mah={CAPACITY_MAH} "
              f"state={state} icon={icon_name(pct, state)}")
        return
    if len(sys.argv) == 3 and sys.argv[1] == "--log":
        log_forever(bus, addr, sys.argv[2])
        return
    tray(bus, addr)


if __name__ == "__main__":
    main()
