#!/usr/bin/env python3
"""Rebuild ~/backup-status/index.html — git log summary for both Pi backup repos.

Called by the Backup Status desktop shortcut before opening the DSI kiosk,
sized for the 800×480 DSI touchscreen (left padding clears the close button).
"""
import html
import subprocess
from datetime import datetime
from pathlib import Path

ROOT = Path.home() / "backup-status"
REPOS = [
    ("Skills & Config", Path.home() / "agentic-skills-backup"),
    ("Memory & Graphs", Path.home() / "agentic-memory-backup"),
]

PAGE = """\
<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Backup Status</title>
<style>
  body {{ margin:0; background:#111; color:#e8e8e8; font:17px/1.4 sans-serif; }}
  h1 {{ margin:0; padding:20px 20px 6px 88px; font-size:20px; font-weight:600; }}
  .ts {{ padding:0 20px 14px 88px; font-size:13px; color:#666; }}
  section {{ margin:0 12px 14px; border:1px solid #2a2a2a; border-radius:6px;
             background:#1a1a1a; overflow:hidden; }}
  h2 {{ margin:0; padding:10px 14px; font-size:16px; font-weight:600;
        background:#1e1e1e; border-bottom:1px solid #2a2a2a; }}
  .empty {{ padding:12px 14px; color:#666; font-size:14px; }}
  ul {{ list-style:none; margin:0; padding:0; }}
  li {{ padding:9px 14px; border-bottom:1px solid #222; font-size:14px;
        display:flex; gap:10px; align-items:baseline; }}
  li:last-child {{ border-bottom:none; }}
  .sha {{ color:#4e9cff; font-family:monospace; font-size:13px; flex:0 0 auto; }}
  .msg {{ color:#d0d0d0; flex:1; }}
  .age {{ color:#666; font-size:12px; flex:0 0 auto; }}
  .err {{ padding:12px 14px; color:#e05c5c; font-size:14px; }}
</style></head>
<body>
<h1>Backup Status</h1>
<div class="ts">Refreshed {ts}</div>
{sections}
</body></html>
"""

ROW = '<li><span class="sha">{sha}</span><span class="msg">{msg}</span><span class="age">{age}</span></li>'


def git_log(repo: Path, n: int = 6):
    if not repo.is_dir():
        return None
    try:
        out = subprocess.check_output(
            ["git", "-C", str(repo), "log", f"-{n}",
             "--format=%h\x1f%s\x1f%ar"],
            text=True, stderr=subprocess.DEVNULL
        )
        return [line.split("\x1f", 2) for line in out.strip().splitlines() if line]
    except subprocess.CalledProcessError:
        # Empty repo (no commits yet) or other git error — show "No commits yet"
        return [] if (repo / ".git").is_dir() else None
    except Exception:
        return None


def render_section(title: str, repo: Path) -> str:
    entries = git_log(repo)
    if entries is None:
        body = f'<div class="err">Could not read {html.escape(str(repo))}</div>'
    elif not entries:
        body = '<div class="empty">No commits yet.</div>'
    else:
        rows = "".join(
            ROW.format(sha=html.escape(e[0]), msg=html.escape(e[1]), age=html.escape(e[2]))
            for e in entries
        )
        body = f"<ul>{rows}</ul>"
    return f'<section><h2>{html.escape(title)}</h2>{body}</section>'


def main():
    ROOT.mkdir(parents=True, exist_ok=True)
    sections = "\n".join(render_section(t, r) for t, r in REPOS)
    ts = datetime.now().strftime("%d %b %Y %H:%M")
    tmp = ROOT / ".index.html.tmp"
    tmp.write_text(PAGE.format(ts=ts, sections=sections))
    tmp.replace(ROOT / "index.html")


if __name__ == "__main__":
    main()
