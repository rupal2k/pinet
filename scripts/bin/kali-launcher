#!/usr/bin/env python3
"""PINET Kali Launcher -- a click-per-tool GUI over the natively-installed
pentest tools, replacing the plain "Kali Tools" terminal shortcut.

The top of the window is a grid of tool buttons grouped by purpose. Clicking a
tool opens a small form (guide defaults prefilled), shows the exact command it
will run, and then either streams its output into the bottom pane (plain-text
tools) or opens it in a terminal window (curses / interactive tools). Tools
that need root are run through pkexec, so each escalation is a polkit prompt --
no passwordless assumptions.

Design notes / ceilings:
- GTK3 only: this Pi's python3-gi has no GTK4 and no Vte, so the "terminal
  window in the bottom" is a read-only streaming TextView, not an embedded
  terminal. Curses tools (airodump-ng, wifite, ...) can't render there, so they
  open in lxterminal instead -- flagged `stream=False` in the registry.
- All GTK imports are lazy (inside run_gui) so the pure registry + argv logic
  below imports and tests without a display or gi installed.

Everything above the "GUI" banner is pure and unit-tested in
tests/test_kali_launcher.py; keep it free of gi imports.
"""
import os
import shutil
import subprocess

# ---- interfaces (from the Kali tools guide) --------------------------------
# wlan0 = PINET hotspot radio (leave alone). wlan1 = the monitor-capable
# TP-Link (also the home uplink). Defaults point at wlan1 for auditing and the
# local subnet for scanning.
UPLINK_IFACE = "wlan1"
PENTEST_START = "/usr/local/sbin/wifi-pentest-start"
PENTEST_STOP = "/usr/local/sbin/wifi-pentest-stop"
PENTEST_FLAG = "/run/pentest-mode"
KALI_WORK = os.path.expanduser("~/kali-work")
ACK_FILE = os.path.expanduser("~/.config/kali-launcher/authorized")

AUTHORIZATION_TEXT = (
    "Only scan, capture, or test networks and devices you OWN or have EXPLICIT "
    "WRITTEN PERMISSION to test.\n\n"
    "Deauthing, capturing handshakes, or brute-forcing WPS on networks you do "
    "not own is illegal in most countries. Use these tools on your own home "
    "network, a lab you control, or an engagement with a signed scope.\n\n"
    "Switching wlan1 to monitor mode (Pentest Mode) also DROPS this Pi's "
    "internet and any SSH session over wlan1. Run it from the physical "
    "screen or over the PINET hotspot so you keep a way back."
)


def _default_cidr():
    """Best-effort local /24 for scan defaults, from the uplink's IP.
    Falls back to the known home subnet. Pure-ish: shells out read-only."""
    try:
        out = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", UPLINK_IFACE],
            capture_output=True, text=True, timeout=3,
        ).stdout
        for tok in out.split():
            if "/" in tok and tok.count(".") == 3:
                a, b, c, _ = tok.split("/")[0].split(".")
                return f"{a}.{b}.{c}.0/24"
    except Exception:
        pass
    return "192.168.29.0/24"


# ---- tool registry ---------------------------------------------------------
# Each tool: key, label, group, bin, root(needs pkexec), stream(True=output
# pane / False=open in a terminal), needs_monitor(warn if wlan1 not monitor),
# fields [(name, label, hint, default)], and argv(vals) -> list of args after
# the binary. argv is pure and unit-tested.

def _tool(**k):
    k.setdefault("root", False)
    k.setdefault("stream", True)
    k.setdefault("needs_monitor", False)
    k.setdefault("desc", "")
    k.setdefault("fields", [])
    k.setdefault("argv", lambda v: [])
    return k


def build_tools(cidr=None):
    cidr = cidr or _default_cidr()
    return [
        # -- Network mapping --
        _tool(key="nmap", label="Nmap", desc="Host & port scanner",
              group="Network mapping", bin="nmap",
              fields=[("flags", "Scan flags", "-sn ping sweep; -sV -p- full", "-sn"),
                      ("target", "Target", "host, range or CIDR", cidr)],
              argv=lambda v: v["flags"].split() + [v["target"]]),
        _tool(key="arp-scan", label="ARP scan", desc="Find hosts on the LAN",
              group="Network mapping", bin="arp-scan", root=True,
              fields=[("iface", "Interface", "L2 scan needs a real iface", UPLINK_IFACE)],
              argv=lambda v: ["-I", v["iface"], "--localnet"]),
        _tool(key="netdiscover", label="Netdiscover", desc="ARP recon sweep",
              group="Network mapping", bin="netdiscover", root=True,
              fields=[("iface", "Interface", "", UPLINK_IFACE),
                      ("range", "Range", "blank = auto from iface", cidr)],
              argv=lambda v: ["-P", "-i", v["iface"]] + (["-r", v["range"]] if v["range"].strip() else [])),
        _tool(key="masscan", label="Masscan", desc="Fast port scanner",
              group="Network mapping", bin="masscan", root=True,
              fields=[("target", "Target", "CIDR or host", cidr),
                      ("ports", "Ports", "", "1-1000"),
                      ("rate", "Rate", "packets/sec -- keep modest on a Pi", "500")],
              argv=lambda v: [v["target"], "-p", v["ports"], "--rate", v["rate"]]),

        # -- WiFi auditing (root; most need monitor mode; curses -> terminal) --
        _tool(key="airmon-ng", label="airmon-ng", desc="Monitor-mode status",
              group="WiFi auditing", bin="airmon-ng", root=True, stream=True,
              fields=[], argv=lambda v: []),
        _tool(key="airodump-ng", label="airodump-ng", desc="Survey nearby APs",
              group="WiFi auditing", bin="airodump-ng", root=True, stream=False, needs_monitor=True,
              fields=[("mon", "Monitor iface", "e.g. wlan1 or wlan1mon", UPLINK_IFACE)],
              argv=lambda v: [v["mon"]]),
        _tool(key="wifite", label="wifite", desc="Automated WiFi audit",
              group="WiFi auditing", bin="wifite", root=True, stream=False, needs_monitor=True,
              fields=[("iface", "Interface", "wifite manages monitor mode itself", UPLINK_IFACE)],
              argv=lambda v: ["-i", v["iface"]]),
        _tool(key="reaver", label="reaver", desc="WPS PIN test",
              group="WiFi auditing", bin="reaver", root=True, stream=False, needs_monitor=True,
              fields=[("mon", "Monitor iface", "", UPLINK_IFACE),
                      ("bssid", "BSSID", "target AP MAC", ""),
                      ("channel", "Channel", "", "")],
              argv=lambda v: ["-i", v["mon"], "-b", v["bssid"]] + (["-c", v["channel"]] if v["channel"].strip() else []) + ["-vv"]),
        _tool(key="bully", label="bully", desc="WPS PIN test",
              group="WiFi auditing", bin="bully", root=True, stream=False, needs_monitor=True,
              fields=[("mon", "Monitor iface", "", UPLINK_IFACE),
                      ("bssid", "BSSID", "target AP MAC", "")],
              argv=lambda v: [v["mon"], "-b", v["bssid"]]),
        _tool(key="mdk4", label="mdk4", desc="WiFi stress test",
              group="WiFi auditing", bin="mdk4", root=True, stream=False, needs_monitor=True,
              fields=[("mon", "Monitor iface", "", UPLINK_IFACE),
                      ("mode", "Mode", "e.g. b beacon flood (test only)", "b")],
              argv=lambda v: [v["mon"], v["mode"]]),
        _tool(key="hcxdumptool", label="hcxdumptool", desc="Capture PMKID / handshakes",
              group="WiFi auditing", bin="hcxdumptool", root=True, stream=False, needs_monitor=True,
              fields=[("mon", "Monitor iface", "", UPLINK_IFACE),
                      ("out", "Output pcapng", "saved under kali-work", os.path.join(KALI_WORK, "capture.pcapng"))],
              argv=lambda v: ["-i", v["mon"], "-w", v["out"]]),
        _tool(key="aircrack-ng", label="aircrack-ng", desc="Crack a capture",
              group="WiFi auditing", bin="aircrack-ng", root=False, stream=False,
              fields=[("cap", "Capture file", ".cap/.pcapng with a handshake", os.path.join(KALI_WORK, "capture.pcapng")),
                      ("wordlist", "Wordlist", "", "/usr/share/wordlists/rockyou.txt")],
              argv=lambda v: [v["cap"], "-w", v["wordlist"]]),

        # -- Supporting --
        _tool(key="macchanger", label="MAC changer", desc="Randomize / show MAC",
              group="Supporting", bin="macchanger", root=True,
              fields=[("iface", "Interface", "iface must be DOWN to change", UPLINK_IFACE),
                      ("flags", "Flags", "-r random, -p permanent, -s show", "-s")],
              argv=lambda v: [v["flags"], v["iface"]]),
        _tool(key="iw", label="iw", desc="Radio & iface info",
              group="Supporting", bin="iw",
              fields=[("args", "Arguments", "e.g. 'dev', 'wlan1 info', 'list'", "dev")],
              argv=lambda v: v["args"].split()),
        _tool(key="tcpdump", label="tcpdump", desc="Packet capture",
              group="Supporting", bin="tcpdump", root=True,
              fields=[("iface", "Interface", "", UPLINK_IFACE),
                      ("count", "Packets", "stop after N", "20"),
                      ("filter", "Filter", "BPF, e.g. 'port 53'", "")],
              argv=lambda v: ["-i", v["iface"], "-c", v["count"], "-n"] + (v["filter"].split() if v["filter"].strip() else [])),
    ]


GROUP_ORDER = ["Network mapping", "WiFi auditing", "Supporting"]
# accent dot + one-line subtitle per group (restrained: dots differentiate,
# text stays neutral -- no full recolour).
GROUP_META = {
    "Network mapping": ("#38BDF8", "Discover hosts and open ports"),
    "WiFi auditing": ("#F59E0B", "Survey and test WiFi -- needs monitor mode"),
    "Supporting": ("#22C55E", "Interfaces, MAC and capture"),
}


def resolve_bin(name):
    """Full path of a tool, searching sbin too (guide tools live in /usr/sbin).
    Returns None if truly absent."""
    p = shutil.which(name)
    if p:
        return p
    for d in ("/usr/sbin", "/sbin", "/usr/local/sbin"):
        cand = os.path.join(d, name)
        if os.path.exists(cand):
            return cand
    return None


def build_argv(tool, values, binpath=None):
    """Full argv list for a tool + field values, pkexec-prefixed if root.
    Pure -- the unit-tested core."""
    binpath = binpath or tool["bin"]
    argv = [binpath] + [str(a) for a in tool["argv"](values)]
    if tool.get("root"):
        argv = ["pkexec"] + argv
    return argv


def monitor_active(iface=UPLINK_IFACE):
    """True if wlan1 is in monitor mode (pentest mode on). Reads the flag file
    first (cheap, set by kali-power-shed), then falls back to `iw`."""
    if os.path.exists(PENTEST_FLAG):
        return True
    try:
        out = subprocess.run(["iw", "dev", iface, "info"],
                             capture_output=True, text=True, timeout=3).stdout
        return any(line.split()[1] == "monitor"
                   for line in out.splitlines()
                   if line.strip().startswith("type"))
    except Exception:
        return False


# ============================ GUI ==========================================
# Everything below imports gi lazily and is exercised by the on-Pi smoke test,
# not the stdlib unit tests.

def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gio, GLib, Gdk

    cidr = _default_cidr()
    TOOLS = build_tools(cidr)

    # Palette: "developer tool / IDE -- code dark + run green" (ui-ux-pro-max
    # colors.csv). Clean & sharp: hairline 1px borders, 4px radius, flat panels
    # (no gradients / no glow), tight spacing grid, system monospace (offline).
    CSS = b"""
    * { outline: none; }
    .root { background-color: #0F172A; }
    .titlebar { background-color: #0B1220; border-bottom: 1px solid #1E293B;
                padding: 10px 14px; }
    .app-title { color: #F8FAFC; font-weight: 800; font-size: 15px;
                 letter-spacing: 2px; }
    .app-sub { color: #64748B; font-size: 10px; letter-spacing: 1px; }
    .pill { border-radius: 4px; padding: 4px 10px; font-size: 10px;
            font-weight: 700; letter-spacing: 1px; border: 1px solid transparent; }
    .pill-off { background-color: #0F1E17; color: #22C55E; border-color: #14532D; }
    .pill-on  { background-color: #2A1113; color: #F87171; border-color: #7F1D1D; }
    .ghost { background: none; color: #CBD5E1; border: 1px solid #334155;
             border-radius: 4px; padding: 6px 12px; font-size: 12px; }
    .ghost:hover { background-color: #16202E; border-color: #475569; color: #F8FAFC; }
    .danger { border-color: #7F1D1D; color: #FCA5A5; }
    .danger:hover { background-color: #2A1113; border-color: #B91C1C; color: #FEE2E2; }
    .card { background-color: #111A2B; border: 1px solid #1E293B;
            border-radius: 6px; }
    .card-title { color: #E2E8F0; font-weight: 700; font-size: 11px;
                  letter-spacing: 2px; }
    .card-sub { color: #64748B; font-size: 10px; }
    .dot { border-radius: 3px; min-width: 8px; min-height: 8px; }
    .tool { background-color: #0F1830; border: 1px solid #24324A;
            border-radius: 5px; padding: 0; }
    .tool:hover { background-color: #142138; border-color: #22C55E; }
    .tool:disabled { opacity: 0.4; }
    .tool-name { color: #F1F5F9; font-weight: 600; font-size: 13px; }
    .tool-desc { color: #7C8AA0; font-size: 10px; }
    .badge { color: #FBBF24; font-size: 9px; font-weight: 700; letter-spacing: 1px;
             border: 1px solid #4D3B12; border-radius: 3px; padding: 0 4px; }
    .pane-bar { background-color: #0B1220; border: 1px solid #1E293B;
                border-bottom: none; border-radius: 6px 6px 0 0; padding: 6px 10px; }
    .pane-title { color: #94A3B8; font-size: 11px; font-weight: 700; letter-spacing: 2px; }
    .term { border: 1px solid #1E293B; border-radius: 0 0 6px 6px; }
    .term text { background-color: #020617; color: #4ADE80;
                 font-family: monospace; font-size: 11px; }
    .mini { padding: 3px 10px; font-size: 11px; }
    dialog, .card entry { }
    entry { background-color: #0B1220; color: #F8FAFC; border: 1px solid #334155;
            border-radius: 4px; padding: 6px 8px; }
    entry:focus { border-color: #22C55E; }
    .cmd { color: #4ADE80; font-family: monospace; font-size: 11px;
           background-color: #020617; border: 1px solid #1E293B; border-radius: 4px;
           padding: 8px; }
    .field-label { color: #94A3B8; font-size: 11px; }
    """

    class Launcher(Gtk.Window):
        def __init__(self):
            super().__init__(title="PINET Kali Launcher")
            self.set_default_size(820, 660)
            self.proc = None  # running Gio.Subprocess for the stream pane
            self._load_css()
            self._build()
            self.connect("destroy", self._on_destroy)

        def _load_css(self):
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def _cls(self, widget, *names):
            ctx = widget.get_style_context()
            for n in names:
                ctx.add_class(n)
            return widget

        # -- layout --
        def _build(self):
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self._cls(root, "root")
            self.add(root)

            root.pack_start(self._header(), False, False, 0)

            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            body.set_margin_top(12); body.set_margin_bottom(10)
            body.set_margin_start(14); body.set_margin_end(14)
            root.pack_start(body, True, True, 0)

            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            grid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            for group in GROUP_ORDER:
                grid.pack_start(self._group_box(group), False, False, 0)
            scroller.add(grid)
            body.pack_start(scroller, True, True, 0)

            body.pack_start(self._output_pane(), False, False, 0)

        def _header(self):
            bar = Gtk.Box(spacing=10)
            self._cls(bar, "titlebar")

            title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            title_box.set_valign(Gtk.Align.CENTER)
            t = Gtk.Label(label="KALI LAUNCHER", xalign=0)
            self._cls(t, "app-title")
            s = Gtk.Label(label="PENTEST TOOLKIT", xalign=0)
            self._cls(s, "app-sub")
            title_box.pack_start(t, False, False, 0)
            title_box.pack_start(s, False, False, 0)
            bar.pack_start(title_box, False, False, 0)

            self.mode_pill = Gtk.Label()
            self.mode_pill.set_valign(Gtk.Align.CENTER)
            bar.pack_start(self.mode_pill, True, True, 6)
            self.mode_pill.set_halign(Gtk.Align.START)
            self._refresh_mode()

            term = self._cls(Gtk.Button(label="Open Terminal"), "ghost")
            term.connect("clicked", lambda *_: self._open_terminal())
            bar.pack_end(term, False, False, 0)
            pen = self._cls(Gtk.Button(label="Toggle Pentest Mode"), "ghost", "danger")
            pen.connect("clicked", lambda *_: self._toggle_pentest())
            bar.pack_end(pen, False, False, 0)
            return bar

        def _group_box(self, group):
            accent, subtitle = GROUP_META[group]
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            self._cls(card, "card")

            head = Gtk.Box(spacing=8)
            head.set_margin_top(10); head.set_margin_bottom(4)
            head.set_margin_start(12); head.set_margin_end(12)
            dot = self._cls(Gtk.Box(), "dot")
            dot.set_valign(Gtk.Align.CENTER)
            self._tint(dot, accent)
            head.pack_start(dot, False, False, 0)
            tl = Gtk.Label(label=group.upper(), xalign=0)
            self._cls(tl, "card-title")
            head.pack_start(tl, False, False, 0)
            sub = Gtk.Label(label=subtitle, xalign=0)
            self._cls(sub, "card-sub")
            sub.set_valign(Gtk.Align.CENTER)
            head.pack_start(sub, False, False, 6)
            card.pack_start(head, False, False, 0)

            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                               max_children_per_line=4, min_children_per_line=2,
                               row_spacing=8, column_spacing=8, homogeneous=True)
            flow.set_margin_top(4); flow.set_margin_bottom(11)
            flow.set_margin_start(12); flow.set_margin_end(12)
            for tool in [t for t in TOOLS if t["group"] == group]:
                flow.add(self._tool_button(tool))
            card.pack_start(flow, False, False, 0)
            return card

        def _tool_button(self, tool):
            btn = self._cls(Gtk.Button(), "tool")
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            inner.set_margin_top(9); inner.set_margin_bottom(9)
            inner.set_margin_start(11); inner.set_margin_end(11)

            top = Gtk.Box(spacing=6)
            name = Gtk.Label(label=tool["label"], xalign=0)
            self._cls(name, "tool-name")
            top.pack_start(name, True, True, 0)
            if tool.get("root"):
                badge = Gtk.Label(label="SUDO")
                self._cls(badge, "badge")
                badge.set_valign(Gtk.Align.CENTER)
                top.pack_end(badge, False, False, 0)
            inner.pack_start(top, False, False, 0)

            desc = Gtk.Label(label=tool["desc"], xalign=0)
            self._cls(desc, "tool-desc")
            inner.pack_start(desc, False, False, 0)
            btn.add(inner)

            present = resolve_bin(tool["bin"]) is not None
            btn.set_sensitive(present)
            btn.set_tooltip_text(
                f"{tool['bin']} is not installed" if not present
                else ("opens in a terminal window" if not tool.get("stream")
                      else "streams into the output pane below"))
            btn.connect("clicked", self._on_tool, tool)
            return btn

        def _output_pane(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            bar = Gtk.Box(spacing=6)
            self._cls(bar, "pane-bar")
            lbl = Gtk.Label(label="OUTPUT", xalign=0)
            self._cls(lbl, "pane-title")
            bar.pack_start(lbl, True, True, 0)
            clr = self._cls(Gtk.Button(label="Clear"), "ghost", "mini")
            clr.connect("clicked", lambda *_: self.buf.set_text(""))
            bar.pack_end(clr, False, False, 0)
            self.stop_btn = self._cls(Gtk.Button(label="Stop"), "ghost", "danger", "mini")
            self.stop_btn.set_sensitive(False)
            self.stop_btn.connect("clicked", lambda *_: self._stop())
            bar.pack_end(self.stop_btn, False, False, 0)
            box.pack_start(bar, False, False, 0)

            term = Gtk.ScrolledWindow()
            self._cls(term, "term")
            term.set_min_content_height(150)
            self.view = Gtk.TextView(editable=False, cursor_visible=False,
                                     monospace=True, wrap_mode=Gtk.WrapMode.CHAR)
            self.view.set_left_margin(10); self.view.set_top_margin(8)
            self.view.set_right_margin(10); self.view.set_bottom_margin(8)
            self.buf = self.view.get_buffer()
            self.buf.set_text("Ready. Pick a tool above.\n")
            term.add(self.view)
            box.pack_start(term, False, False, 0)
            return box

        def _tint(self, widget, hexcolor):
            prov = Gtk.CssProvider()
            prov.load_from_data(
                (".dot{background-color:%s;}" % hexcolor).encode())
            widget.get_style_context().add_provider(
                prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

        # -- actions --
        def _on_tool(self, _btn, tool):
            binpath = resolve_bin(tool["bin"])
            if not binpath:
                return
            vals = self._prompt_fields(tool)
            if vals is None:
                return
            if tool.get("needs_monitor") and not monitor_active():
                if not self._confirm(
                        "Monitor mode is off",
                        f"{tool['label']} needs wlan1 in monitor mode. Turn on "
                        "Pentest Mode first (it drops internet + SSH). Run anyway?"):
                    return
            argv = build_argv(tool, vals, binpath)
            if tool.get("stream"):
                self._run_stream(argv)
            else:
                self._run_terminal(argv)

        def _prompt_fields(self, tool):
            dlg = Gtk.Dialog(title=tool["label"], transient_for=self, modal=True)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Run", Gtk.ResponseType.OK)
            dlg.set_default_response(Gtk.ResponseType.OK)
            self._cls(dlg, "root")
            box = dlg.get_content_area()
            box.set_spacing(6)
            box.set_margin_top(12); box.set_margin_bottom(12)
            box.set_margin_start(14); box.set_margin_end(14)

            hdr = Gtk.Label(xalign=0)
            root_note = "  ·  runs as root (password prompt)" if tool.get("root") else ""
            hdr.set_markup(
                f"<b>{GLib.markup_escape_text(tool['label'])}</b>  "
                f"<span foreground='#7C8AA0'>{GLib.markup_escape_text(tool['desc'])}"
                f"{root_note}</span>")
            box.pack_start(hdr, False, False, 0)
            box.pack_start(Gtk.Separator(), False, False, 4)

            entries = {}
            for name, label, hint, default in tool["fields"]:
                lab = Gtk.Label(label=label, xalign=0)
                self._cls(lab, "field-label")
                box.pack_start(lab, False, False, 0)
                e = Gtk.Entry(text=default)
                if hint:
                    e.set_placeholder_text(hint)
                    e.set_tooltip_text(hint)
                box.pack_start(e, False, False, 0)
                entries[name] = e

            cl = Gtk.Label(label="COMMAND", xalign=0)
            self._cls(cl, "field-label")
            cl.set_margin_top(4)
            box.pack_start(cl, False, False, 0)
            preview = Gtk.Label(xalign=0, selectable=True)
            preview.set_line_wrap(True)
            self._cls(preview, "cmd")
            box.pack_start(preview, False, False, 0)

            def refresh(*_):
                v = {n: e.get_text() for n, e in entries.items()}
                try:
                    cmd = " ".join(build_argv(tool, v, resolve_bin(tool["bin"])))
                except Exception as exc:  # a field left in a bad state
                    cmd = f"(incomplete: {exc})"
                preview.set_text(cmd)
            for e in entries.values():
                e.connect("changed", refresh)
            refresh()

            dlg.show_all()
            resp = dlg.run()
            vals = {n: e.get_text() for n, e in entries.items()} if resp == Gtk.ResponseType.OK else None
            dlg.destroy()
            return vals

        def _run_stream(self, argv):
            self._stop()
            self._append(f"\n$ {' '.join(argv)}\n")
            os.makedirs(KALI_WORK, exist_ok=True)
            try:
                launcher = Gio.SubprocessLauncher(
                    flags=Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
                launcher.set_cwd(KALI_WORK)
                self.proc = launcher.spawnv(argv)
            except GLib.Error as exc:
                self._append(f"[failed to start: {exc.message}]\n")
                return
            self.stop_btn.set_sensitive(True)
            stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
            self._read_next(stream)
            self.proc.wait_async(None, self._on_exit)

        def _read_next(self, stream):
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line, stream)

        def _on_line(self, stream, res, _data):
            try:
                line, _ = stream.read_line_finish_utf8(res)
            except GLib.Error:
                return
            if line is None:
                return
            self._append(line + "\n")
            self._read_next(stream)

        def _on_exit(self, proc, _res):
            try:
                proc.wait_finish(_res)
                code = proc.get_exit_status()
                self._append(f"[exited {code}]\n")
            except GLib.Error:
                pass
            self.stop_btn.set_sensitive(False)
            self.proc = None

        def _stop(self):
            if self.proc is not None:
                try:
                    self.proc.force_exit()
                except GLib.Error:
                    pass
                self.proc = None
            self.stop_btn.set_sensitive(False)

        def _run_terminal(self, argv):
            # Curses / interactive tool: open in lxterminal so its full-screen
            # UI works. Hold the window open after it exits.
            inner = " ".join(GLib.shell_quote(a) for a in argv)
            os.makedirs(KALI_WORK, exist_ok=True)
            bash = f'{inner}; echo; read -n1 -r -p "[finished -- press any key to close]"'
            term_argv = ["env", "GDK_BACKEND=wayland", "lxterminal",
                         f"--working-directory={KALI_WORK}",
                         "-e", "bash", "-lc", bash]
            self._append(f"\n$ {inner}   (opened in a terminal window)\n")
            try:
                Gio.Subprocess.new(term_argv, Gio.SubprocessFlags.NONE)
            except GLib.Error as exc:
                self._append(f"[could not open terminal: {exc.message}]\n")

        def _open_terminal(self):
            os.makedirs(KALI_WORK, exist_ok=True)
            try:
                Gio.Subprocess.new(
                    ["env", "GDK_BACKEND=wayland", "lxterminal",
                     f"--working-directory={KALI_WORK}"],
                    Gio.SubprocessFlags.NONE)
            except GLib.Error as exc:
                self._append(f"[could not open terminal: {exc.message}]\n")

        def _toggle_pentest(self):
            on = monitor_active()
            script = PENTEST_STOP if on else PENTEST_START
            verb = "STOP" if on else "START"
            warn = ("This restores wlan1 to managed mode and brings PINET + "
                    "internet back." if on else
                    "This switches wlan1 to monitor mode and DROPS this Pi's "
                    "internet and any SSH session over wlan1. Only do this from "
                    "the physical screen or the PINET hotspot.")
            if not self._confirm(f"{verb} Pentest Mode?", warn):
                return
            self._append(f"\n$ pkexec {script}\n")
            try:
                proc = Gio.Subprocess.new(["pkexec", script],
                                          Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
            except GLib.Error as exc:
                self._append(f"[failed: {exc.message}]\n")
                return
            stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
            self._read_next(stream)
            proc.wait_async(None, lambda p, r: (self._refresh_mode(),))

        def _refresh_mode(self):
            on = monitor_active()
            ctx = self.mode_pill.get_style_context()
            for c in ("pill", "pill-on", "pill-off"):
                ctx.remove_class(c)
            ctx.add_class("pill")
            ctx.add_class("pill-on" if on else "pill-off")
            self.mode_pill.set_text(
                "PENTEST MODE: ON  ·  wlan1 monitor, internet + SSH down" if on
                else "PENTEST MODE: OFF  ·  wlan1 managed, normal networking")

        # -- helpers --
        def _append(self, text):
            end = self.buf.get_end_iter()
            self.buf.insert(end, text)
            self.view.scroll_to_iter(self.buf.get_end_iter(), 0.0, False, 0, 0)

        def _confirm(self, title, msg):
            d = Gtk.MessageDialog(transient_for=self, modal=True,
                                  message_type=Gtk.MessageType.WARNING,
                                  buttons=Gtk.ButtonsType.OK_CANCEL, text=title)
            d.format_secondary_text(msg)
            ok = d.run() == Gtk.ResponseType.OK
            d.destroy()
            return ok

        def _on_destroy(self, *_):
            self._stop()
            Gtk.main_quit()

    def authorized():
        if os.path.exists(ACK_FILE):
            return True
        d = Gtk.MessageDialog(modal=True, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.NONE,
                              text="Authorized use only")
        d.format_secondary_text(AUTHORIZATION_TEXT)
        d.add_buttons("Quit", Gtk.ResponseType.CANCEL,
                      "I have authorization", Gtk.ResponseType.OK)
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        if ok:
            os.makedirs(os.path.dirname(ACK_FILE), exist_ok=True)
            with open(ACK_FILE, "w") as fh:
                fh.write("acknowledged\n")
        return ok

    if not authorized():
        return
    win = Launcher()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    run_gui()
