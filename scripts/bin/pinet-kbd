#!/bin/sh
# PINET on-screen keyboard (wvkbd, manual + touch-friendly, dark).
# On demand: nothing runs while the keyboard is down. pinet-kbd-button starts
# wvkbd and its floating pull-down tab together; both exit together.
#   show   - open the keyboard (the taskbar keyboard icon runs this)
#   hide   - close it
#   toggle - open if closed, close if open
up() { pgrep -x wvkbd-mobintl >/dev/null; }
open_kbd() { setsid pinet-kbd-button </dev/null >/dev/null 2>&1 & }

case "$1" in
    show)   up || open_kbd ;;
    hide)   pkill -x wvkbd-mobintl ;;
    toggle) if up; then pkill -x wvkbd-mobintl; else open_kbd; fi ;;
    *) echo "usage: pinet-kbd show|hide|toggle" >&2; exit 2 ;;
esac
exit 0
