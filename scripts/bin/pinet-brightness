#!/usr/bin/env python3
"""DSI screen brightness in the taskbar tray.

A StatusNotifierItem (like pinet-battery): tap the sun icon for a slider just
above the taskbar, or scroll on it. Each new level goes through
`sudo -n dsi-backlight.sh set N`, which also saves it as BRIGHTNESS in
/etc/default/dsi-screen, so wake and boot come back at the same level.
The slider stops at MIN_LEVEL, so it can never turn the screen fully dark.

The module is gi-free at import (the tray imports gi lazily), so the level
logic is tested without a display.
"""
import glob
import os
import subprocess
import sys

MIN_LEVEL, MAX_LEVEL = 10, 255
SCROLL_STEP = 16
APPLY_DELAY_MS = 120      # coalesce slider drags into one sudo call
HIDE_AFTER_S = 4          # the popup closes itself after this long untouched
CONF = "/etc/default/dsi-screen"
BACKLIGHT = os.environ.get("BACKLIGHT_GLOB", "/sys/class/backlight/*/brightness")
ICON_DIR = os.path.expanduser(os.environ.get("ICON_DIR", "~/.local/share/icons"))
ICON = "pinet-brightness"
SETTER = ["sudo", "-n", "/usr/local/bin/dsi-backlight.sh", "set"]


def clamp(level):
    return max(MIN_LEVEL, min(MAX_LEVEL, int(level)))


def scrolled(level, delta):
    """Level after a scroll; SNI sends +/-120 per notch, some trays +/-1."""
    if delta == 0:
        return clamp(level)
    return clamp(level + (SCROLL_STEP if delta > 0 else -SCROLL_STEP))


def percent(level):
    return round(100 * level / MAX_LEVEL)


def saved_level(conf=CONF):
    try:
        with open(conf) as f:
            for line in f:
                key, _, value = line.strip().partition("=")
                if key == "BRIGHTNESS" and value.strip().isdigit():
                    return clamp(value.strip())
    except OSError:
        pass
    return MAX_LEVEL


def current_level(pattern=BACKLIGHT, conf=CONF):
    """The live level while the screen is on, else the saved one."""
    for path in glob.glob(pattern):
        try:
            live = int(open(path).read())
        except (OSError, ValueError):
            continue
        if live > 0:
            return clamp(live)
    return saved_level(conf)


SNI_XML = """<node><interface name="org.kde.StatusNotifierItem">
<property name="Category" type="s" access="read"/>
<property name="Id" type="s" access="read"/>
<property name="Title" type="s" access="read"/>
<property name="Status" type="s" access="read"/>
<property name="IconName" type="s" access="read"/>
<property name="IconThemePath" type="s" access="read"/>
<property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
<property name="ItemIsMenu" type="b" access="read"/>
<method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
<signal name="NewToolTip"/>
</interface></node>"""


def tray():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gio, GLib, Gtk, GtkLayerShell

    state = {"level": current_level(), "pending": None, "hide": None, "proc": None}
    conn = Gio.bus_get_sync(Gio.BusType.SESSION)
    name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
    path = "/StatusNotifierItem"

    def tip():
        return f"Screen brightness {percent(state['level'])}%"

    def get_prop(_c, _s, _p, _i, prop):
        return {
            "Category": GLib.Variant("s", "Hardware"),
            "Id": GLib.Variant("s", "pinet-brightness"),
            "Title": GLib.Variant("s", tip()),
            "Status": GLib.Variant("s", "Active"),
            "IconName": GLib.Variant("s", ICON),
            "IconThemePath": GLib.Variant("s", ICON_DIR),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (ICON, [], "Brightness", tip())),
            "ItemIsMenu": GLib.Variant("b", False),
        }.get(prop)

    # --- the popup: a slider anchored bottom-right, above the taskbar ---
    win = Gtk.Window()
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, 6)
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.RIGHT, 6)
    css = Gtk.CssProvider()
    css.load_from_data(b"""
        window { background-color: rgba(20,22,26,0.92); border-radius: 10px; }
        label { color: #e8e8e8; font-weight: bold; }
        scale trough { min-height: 10px; }
        scale slider { min-width: 30px; min-height: 30px; }
    """)
    Gtk.StyleContext.add_provider_for_screen(win.get_screen(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    box.set_border_width(12)
    icon = Gtk.Image.new_from_file(os.path.join(ICON_DIR, ICON + ".svg"))
    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, MIN_LEVEL, MAX_LEVEL, 1)
    scale.set_draw_value(False)
    scale.set_size_request(240, -1)          # wide enough to drag with a finger
    label = Gtk.Label(label="")
    label.set_width_chars(4)
    for w in (icon, scale, label):
        box.pack_start(w, w is scale, w is scale, 0)
    win.add(box)

    def schedule_hide():
        if state["hide"]:
            GLib.source_remove(state["hide"])
        state["hide"] = GLib.timeout_add_seconds(HIDE_AFTER_S, hide)

    def hide():
        state["hide"] = None
        win.hide()
        return False

    def apply():
        state["pending"] = None
        proc = state["proc"]
        if proc and proc.poll() is None:      # previous write still running
            state["pending"] = GLib.timeout_add(APPLY_DELAY_MS, apply)
            return False
        state["proc"] = subprocess.Popen(SETTER + [str(state["level"])],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return False

    def set_level(level):
        level = clamp(level)
        changed = level != state["level"]
        state["level"] = level
        label.set_text(f"{percent(level)}%")
        if changed:
            if state["pending"] is None:
                state["pending"] = GLib.timeout_add(APPLY_DELAY_MS, apply)
            conn.emit_signal(None, path, "org.kde.StatusNotifierItem", "NewToolTip", None)

    def on_scale(_w):
        set_level(scale.get_value())
        schedule_hide()
    scale.connect("value-changed", on_scale)

    def show():
        state["level"] = current_level()      # the panel may have changed it
        scale.set_value(state["level"])
        label.set_text(f"{percent(state['level'])}%")
        win.show_all()
        schedule_hide()

    def call(_c, _s, _p, _i, method, args, invocation):
        if method in ("Activate", "SecondaryActivate"):
            hide() if win.get_visible() else show()
        elif method == "Scroll":
            delta, orientation = args.unpack()
            if orientation.lower() == "vertical":
                # Most trays send scroll-up as a negative delta.
                set_level(scrolled(state["level"], -delta))
                if win.get_visible():
                    scale.set_value(state["level"])
                    schedule_hide()
        invocation.return_value(None)

    iface = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
    conn.register_object(path, iface, call, get_prop, None)
    Gio.bus_own_name_on_connection(conn, name, Gio.BusNameOwnerFlags.NONE, None, None)

    def register(*_):
        # Again every time the panel (the watcher) comes back after a respawn.
        conn.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                  "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
                  GLib.Variant("(s)", (name,)), None, Gio.DBusCallFlags.NONE, -1, None, None)
    Gio.bus_watch_name_on_connection(conn, "org.kde.StatusNotifierWatcher",
                                     Gio.BusNameWatcherFlags.NONE, register, None)
    Gtk.main()


def main():
    if sys.argv[1:] == ["--once"]:
        level = current_level()
        print(f"level={level} percent={percent(level)} saved={saved_level()}")
        return
    tray()


if __name__ == "__main__":
    main()
