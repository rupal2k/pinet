#!/bin/bash
# Show, hide or toggle the on-screen keyboard.
#
# squeekboard has no hide key of its own and no window controls -- once it is
# up it stays up until whatever has the text cursor gives up focus, which on a
# kiosk may be never. It does export sm.puri.OSK0 on the session bus, and
# SetVisible there is the same switch the compositor uses.
#
#   usage: pinet-keyboard [toggle|show|hide]
set -u

BUS=sm.puri.OSK0
OBJ=/sm/puri/OSK0

visible() { busctl --user get-property "$BUS" "$OBJ" "$BUS" Visible 2>/dev/null | awk '{print $2}'; }

case "${1:-toggle}" in
  show) want=true ;;
  hide) want=false ;;
  toggle) [ "$(visible)" = "true" ] && want=false || want=true ;;
  *) echo "usage: ${0##*/} [toggle|show|hide]" >&2; exit 2 ;;
esac

busctl --user call "$BUS" "$OBJ" "$BUS" SetVisible b "$want" || {
    echo "on-screen keyboard is not running" >&2; exit 1; }
echo "keyboard visible: $want"
