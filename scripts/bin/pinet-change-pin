#!/usr/bin/env python3
"""Security Tools — PIN management and manual LUKS unlock for the DSI device.

Home menu offers:
  - Change PIN  → verify old → enter new → confirm
  - Unlock Drive → enter PIN → cryptsetup open + mount

Recovery: sudo sh -c 'echo -n "NEWPIN" > /etc/dsi-lock/passcode'
"""
import os
import subprocess
import sys
import time

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, GtkLayerShell

PASSCODE_FILE = "/etc/dsi-lock/passcode"
LOGO_FILE     = "/etc/dsi-lock/logo.png"
LUKS_MARKER   = "/etc/pinet-luks"
LUKS_DEV      = "/dev/sda"
LUKS_NAME     = "pinet-media"
MOUNT_POINT   = "/mnt/pinet-media"
RUNTIME       = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())

MIN_PIN_LEN = 4
MAX_PIN_LEN = 8

CSS = b"""
window { background-color: #0f1114; }
#title { color: #e8e8e8; font-size: 20px; font-weight: bold; }
#sub   { color: #888888; font-size: 13px; }
#dots  { color: #e8e8e8; font-size: 26px; }
#dots.bad     { color: #d24141; }
#dots.good    { color: #3cb371; }
#dots.waiting { color: #888888; }
button.key {
    background: #282c30;
    color: #e8e8e8;
    font-size: 23px;
    border-radius: 12px;
    border: 2px solid rgba(255,255,255,0.14);
    min-width: 90px;
    min-height: 50px;
    margin: 3px;
}
button.key:active { background: #5078b4; }
button.confirm {
    background: #1e5c3a;
    color: #e8e8e8;
    font-size: 16px;
    border-radius: 10px;
    border: 2px solid rgba(60,179,113,0.4);
    min-width: 120px;
    min-height: 38px;
    margin-top: 4px;
}
button.confirm:active { background: #2e7a52; }
button.off {
    background: #3c4044;
    color: #e8e8e8;
    font-size: 14px;
    border-radius: 18px;
    border: 2px solid rgba(255,255,255,0.18);
    min-width: 100px;
    min-height: 36px;
    padding: 0 6px;
}
button.off:active { background: #7a3c3c; }
button.menu {
    background: #1c2028;
    color: #e8e8e8;
    font-size: 18px;
    border-radius: 14px;
    border: 2px solid rgba(255,255,255,0.18);
    min-width: 240px;
    min-height: 52px;
    margin: 5px;
}
button.menu:active { background: #5078b4; }
"""

# Steps
HOME        = "home"
VERIFY_OLD  = "verify"
ENTER_NEW   = "new"
CONFIRM_NEW = "confirm"
UNLOCK_DRIVE = "unlock"


def read_passcode():
    try:
        with open(PASSCODE_FILE) as f:
            return f.readline().strip() or None
    except OSError:
        return None


def already_unlocked():
    return (os.path.exists(f"/dev/mapper/{LUKS_NAME}") and
            os.path.ismount(MOUNT_POINT))


def unlock_drive(pin: str):
    subprocess.run(
        ["sudo", "/usr/sbin/cryptsetup", "open", "--key-file", "-", LUKS_DEV, LUKS_NAME],
        input=pin.encode(), check=True
    )
    subprocess.run(["sudo", "/usr/bin/mount", MOUNT_POINT], check=True)


def save_pin(old_pin: str, new_pin: str):
    """Write new PIN to passcode file and rotate the LUKS key if encrypted."""
    # pinet-setpin reads PIN from stdin so it never appears in argv
    subprocess.run(
        ["sudo", "/usr/local/sbin/pinet-setpin"],
        input=new_pin.encode(), check=True
    )

    if not os.path.exists(LUKS_MARKER):
        return

    # Rotate LUKS key via tmpfs key files (never touch disk)
    old_key = os.path.join(RUNTIME, ".luks-old-key")
    new_key = os.path.join(RUNTIME, ".luks-new-key")
    try:
        with open(old_key, "w") as f:
            f.write(old_pin)
        with open(new_key, "w") as f:
            f.write(new_pin)
        subprocess.run(
            ["sudo", "cryptsetup", "luksChangeKey",
             "--batch-mode", "--key-file", old_key,
             LUKS_DEV, new_key],
            check=True
        )
    finally:
        for p in (old_key, new_key):
            try:
                os.unlink(p)
            except OSError:
                pass


class ChangePinDialog:
    def __init__(self):
        self.current_code = read_passcode()
        self.step         = HOME
        self.entered      = ""
        self.new_pin      = ""
        self.fails        = 0
        self.blocked_until = 0.0

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(win, edge, True)
        GtkLayerShell.set_exclusive_zone(win, -1)
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        outer.set_halign(Gtk.Align.CENTER)
        outer.set_valign(Gtk.Align.CENTER)

        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(LOGO_FILE, -1, 56, True)
            outer.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
        except Exception:
            pass

        self.title = Gtk.Label()
        self.title.set_name("title")
        self.sub   = Gtk.Label()
        self.sub.set_name("sub")
        self.dots  = Gtk.Label(label="–")
        self.dots.set_name("dots")

        outer.pack_start(self.title, False, False, 0)
        outer.pack_start(self.sub,   False, False, 0)
        outer.pack_start(self.dots,  False, False, 0)

        # Menu buttons (HOME step only)
        self.menu_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.menu_box.set_no_show_all(True)
        self.menu_box.set_halign(Gtk.Align.CENTER)
        for label, cb in [("Change PIN", self._on_menu_changepin),
                           ("Unlock Drive", self._on_menu_unlock)]:
            b = Gtk.Button(label=label)
            b.get_style_context().add_class("menu")
            b.connect("clicked", cb)
            self.menu_box.pack_start(b, False, False, 0)
        outer.pack_start(self.menu_box, False, False, 0)

        self.grid = Gtk.Grid()
        self.grid.set_halign(Gtk.Align.CENTER)
        self.grid.set_no_show_all(True)
        keys = [("1", 0, 0), ("2", 1, 0), ("3", 2, 0),
                ("4", 0, 1), ("5", 1, 1), ("6", 2, 1),
                ("7", 0, 2), ("8", 1, 2), ("9", 2, 2),
                ("⌫", 0, 3), ("0", 1, 3), ("C", 2, 3)]
        for label, col, row in keys:
            b = Gtk.Button(label=label)
            b.get_style_context().add_class("key")
            b.connect("clicked", self.on_key, label)
            self.grid.attach(b, col, row, 1, 1)
        outer.pack_start(self.grid, False, False, 0)

        # Confirm button — shown only for ENTER_NEW step when >= MIN_PIN_LEN digits
        self.confirm_btn = Gtk.Button(label="✓  Confirm PIN")
        self.confirm_btn.get_style_context().add_class("confirm")
        self.confirm_btn.connect("clicked", self._on_confirm_pin)
        self.confirm_btn.set_no_show_all(True)
        outer.pack_start(self.confirm_btn, False, False, 0)

        # Cancel / back (top-right) — goes back to HOME if not already there
        overlay = Gtk.Overlay()
        overlay.add(outer)
        self.cancel_btn = Gtk.Button(label="Cancel")
        self.cancel_btn.get_style_context().add_class("off")
        self.cancel_btn.set_halign(Gtk.Align.END)
        self.cancel_btn.set_valign(Gtk.Align.START)
        self.cancel_btn.set_margin_top(6)
        self.cancel_btn.set_margin_end(8)
        self.cancel_btn.connect("clicked", self._on_cancel)
        overlay.add_overlay(self.cancel_btn)

        win.add(overlay)
        win.connect("destroy", Gtk.main_quit)
        win.connect("key-press-event", self.on_keypress)
        win.show_all()
        self._update_ui()

    # --- UI helpers ---

    def _update_ui(self):
        self.entered = ""
        if self.step == HOME:
            self.title.set_text("Security Tools")
            self.sub.set_text("Device security settings")
            self.dots.set_text("")
            self.menu_box.show_all()
            self.grid.hide()
            self.confirm_btn.hide()
            self.cancel_btn.set_label("Close")
            return
        # PIN-entry steps
        self.menu_box.hide()
        self.grid.show_all()
        self.cancel_btn.set_label("Back")
        if self.step == VERIFY_OLD:
            self.title.set_text("Change device PIN")
            self.sub.set_text("Enter your current PIN")
            self.confirm_btn.hide()
        elif self.step == ENTER_NEW:
            self.title.set_text("New PIN")
            self.sub.set_text(f"Enter new PIN ({MIN_PIN_LEN}–{MAX_PIN_LEN} digits)")
            self._refresh_confirm_btn()
        elif self.step == CONFIRM_NEW:
            self.title.set_text("Confirm new PIN")
            self.sub.set_text("Re-enter the new PIN to confirm")
            self.confirm_btn.hide()
        elif self.step == UNLOCK_DRIVE:
            if already_unlocked():
                self.title.set_text("Already unlocked")
                self.sub.set_text("USB storage is already mounted")
                self.dots.set_text("✓")
                self.dots.get_style_context().add_class("good")
                self.grid.hide()
                GLib.timeout_add(2000, lambda: (Gtk.main_quit(), False)[1])
                return
            self.title.set_text("Unlock Drive")
            self.sub.set_text("Enter PIN to unlock USB storage")
            self.confirm_btn.hide()
        self.refresh()

    def _refresh_confirm_btn(self):
        if self.step == ENTER_NEW and len(self.entered) >= MIN_PIN_LEN:
            self.confirm_btn.show()
        else:
            self.confirm_btn.hide()

    def refresh(self):
        n = len(self.entered)
        self.dots.set_text("●" * n if n else "–")
        if self.step == ENTER_NEW:
            self._refresh_confirm_btn()

    # --- input ---

    def feed(self, digit):
        if time.monotonic() < self.blocked_until:
            return
        self.dots.get_style_context().remove_class("bad")
        if len(self.entered) >= MAX_PIN_LEN:
            return
        self.entered += digit
        self.refresh()

        # Auto-submit when length matches expected
        code_len = len(self.current_code or "")
        if self.step in (VERIFY_OLD, UNLOCK_DRIVE) and len(self.entered) == code_len:
            GLib.timeout_add(80, self._auto_submit)
        elif self.step == CONFIRM_NEW and len(self.entered) == len(self.new_pin):
            GLib.timeout_add(80, self._auto_submit)

    def _auto_submit(self):
        self._submit()
        return False

    def _on_confirm_pin(self, _btn):
        if self.step == ENTER_NEW and len(self.entered) >= MIN_PIN_LEN:
            self.new_pin = self.entered
            self.step = CONFIRM_NEW
            self._update_ui()

    def _submit(self):
        if self.step == VERIFY_OLD:
            if self.entered == self.current_code:
                self.step = ENTER_NEW
                self._update_ui()
            else:
                self._reject_old()
        elif self.step == UNLOCK_DRIVE:
            if self.entered == self.current_code:
                self._do_unlock_drive()
            else:
                self._reject_old()
        elif self.step == CONFIRM_NEW:
            if self.entered == self.new_pin:
                self._save()
            else:
                self.dots.set_text("✕  PINs don't match")
                self.dots.get_style_context().add_class("bad")
                GLib.timeout_add(900, self._retry_confirm)
        return False

    def _retry_confirm(self):
        self.entered = ""
        self.dots.get_style_context().remove_class("bad")
        self.refresh()
        return False

    def _reject_old(self):
        self.fails += 1
        if self.fails >= 5:
            self.blocked_until = time.monotonic() + min(30 << (self.fails - 5), 3600)
        self.entered = ""
        self.dots.set_text("✕")
        self.dots.get_style_context().add_class("bad")
        GLib.timeout_add(700, self._clear_bad)

    def _clear_bad(self):
        self.dots.get_style_context().remove_class("bad")
        self.refresh()
        return False

    def _save(self):
        self.title.set_text("Saving…")
        self.dots.set_text("●" * len(self.new_pin))
        self.dots.get_style_context().remove_class("bad")
        GLib.timeout_add(80, self._do_save)

    def _do_save(self):
        try:
            save_pin(self.current_code or "", self.new_pin)
            self.title.set_text("PIN changed")
            self.dots.set_text("✓")
            self.dots.get_style_context().add_class("good")
            has_luks = os.path.exists(LUKS_MARKER)
            self.sub.set_text("Lock screen" + " and disk" * has_luks + " PIN updated")
            GLib.timeout_add(2000, Gtk.main_quit)
        except subprocess.CalledProcessError as e:
            self.title.set_text("Failed")
            self.sub.set_text("Could not save PIN")
            self.dots.set_text("✕")
            self.dots.get_style_context().add_class("bad")
            GLib.timeout_add(2000, Gtk.main_quit)
        return False

    def _do_unlock_drive(self):
        self.title.set_text("Unlocking…")
        self.dots.set_text("●" * len(self.entered))
        self.dots.get_style_context().remove_class("bad")
        GLib.timeout_add(50, self._run_unlock)

    def _run_unlock(self):
        try:
            unlock_drive(self.entered)
            self.title.set_text("Drive unlocked")
            self.dots.set_text("✓")
            self.dots.get_style_context().add_class("good")
            self.sub.set_text("USB storage is now mounted")
            GLib.timeout_add(2000, lambda: (Gtk.main_quit(), False)[1])
        except subprocess.CalledProcessError:
            self.title.set_text("Unlock failed")
            self.sub.set_text("Incorrect PIN or drive unavailable")
            self._reject_old()
        return False

    def _on_menu_changepin(self, _btn):
        self.step = VERIFY_OLD
        self._update_ui()

    def _on_menu_unlock(self, _btn):
        self.step = UNLOCK_DRIVE
        self._update_ui()

    def _on_cancel(self, _btn):
        if self.step == HOME:
            Gtk.main_quit()
        else:
            self.step = HOME
            self._update_ui()

    def backspace(self):
        self.entered = self.entered[:-1]
        self.refresh()

    def on_key(self, _btn, label):
        if label.isdigit():
            self.feed(label)
        elif label == "⌫":
            self.backspace()
        elif label == "C":
            self.entered = ""
            self.refresh()

    def on_keypress(self, _w, event):
        name = Gdk.keyval_name(event.keyval) or ""
        if len(name) == 1 and name.isdigit():
            self.feed(name)
        elif name.startswith("KP_") and name[3:].isdigit():
            self.feed(name[3:])
        elif name == "BackSpace":
            self.backspace()
        elif name in ("Return", "KP_Enter"):
            if self.step == ENTER_NEW and len(self.entered) >= MIN_PIN_LEN:
                self._on_confirm_pin(None)
            elif self.entered:
                self._submit()
        elif name == "Escape":
            self._on_cancel(None)
        return True


def main():
    ChangePinDialog()
    Gtk.main()


if __name__ == "__main__":
    main()
