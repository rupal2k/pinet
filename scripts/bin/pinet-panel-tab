#!/usr/bin/env python3
"""Taskbar visibility + touch pull-tab for PINET (GTK3 + wlr layer-shell).

On the desktop (no app window open, or all minimized) the taskbar is shown and
this tab is hidden. While an app window is open -- on the 800x480 panel apps
fill the screen -- the taskbar is hidden so the app gets the whole display, and
a small tab sits at the bottom-centre edge: tap it to show the taskbar (the tab
rides up on top of it), tap again to hide it, or leave it and it re-hides after
SHOW_SECONDS. Open windows are polled with `wlrctl toplevel find`. SIGUSR1
toggles like a tap (for scripts and testing).

wf-panel-pi's own auto-hide can't do this by itself: it only reveals on a
mouse pointer at the bottom edge, which a finger can't do reliably.

Show = `autohide=false` in the panel config (applied live; the taskbar takes its
own strip instead of covering apps). Hide = `autohide=true` plus moving the
pointer off the taskbar: the panel only hides once the pointer *leaves* it, and
on this touchscreen the (invisible) pointer stays wherever the finger last was
-- usually on the taskbar or this tab -- so it would otherwise stay stuck over
the apps. The pointer is moved with wlrctl (wlr virtual-pointer); without
wlrctl the panel is restarted instead (lwrespawn relaunches it, hidden).

Layer TOP: above normal and maximized windows, below the lock screen, the photo
frame (overlay layer) and true fullscreen apps. On exit the taskbar is left
visible, so stopping the tab can never strand you without it.
"""
import fcntl
import os
import shutil
import signal
import subprocess
import sys

INI = os.path.expanduser("~/.config/wf-panel-pi/wf-panel-pi.ini")
PANEL_HEIGHT = 30   # px, icon_size=24 taskbar; the tab stands on its top edge
SHOW_SECONDS = 30
POLL_MS = 1000      # one wlrctl query (~20 ms on the Pi 3B) per second


def with_autohide(text, on):
    """Return panel-config `text` with autohide set to `on` (added under [panel] if absent)."""
    value = "autohide=" + ("true" if on else "false")
    lines = text.splitlines()
    if any(l.startswith("autohide=") for l in lines):
        lines = [value if l.startswith("autohide=") else l for l in lines]
    else:
        at = next((i + 1 for i, l in enumerate(lines) if l.strip() == "[panel]"), None)
        if at is None:
            lines = ["[panel]", value] + lines
        else:
            lines.insert(at, value)
    return "\n".join(lines) + "\n"


def set_autohide(on):
    try:
        text = open(INI).read()
    except OSError:
        text = "[panel]\n"
    new = with_autohide(text, on)
    if new != text:
        tmp = INI + ".tmp"
        with open(tmp, "w") as f:
            f.write(new)
        os.replace(tmp, INI)   # atomic: the panel never reads a half-written file


def app_open():
    """True while any app window is open and not minimized (desktop otherwise)."""
    if not shutil.which("wlrctl"):
        return True   # can't tell: keep the auto-hide + tab behaviour
    try:
        r = subprocess.run(["wlrctl", "toplevel", "find", "state:unminimized"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except subprocess.TimeoutExpired:
        return True
    return r.returncode == 0


def release_pointer():
    """Get the parked pointer off the taskbar so the auto-hiding panel can hide."""
    if shutil.which("wlrctl"):
        subprocess.run(["wlrctl", "pointer", "move", "0", "-150"], check=False, timeout=5)
    else:
        subprocess.run(["pkill", "-x", "wf-panel-pi"], check=False)


def main():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()),
                             "pinet-panel-tab.lock")
    lock = open(lock_path, "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(0)   # already running

    css = b"""
    window { background: transparent; }
    button {
      background: #1e2128;
      color: #eef0f3;
      border: 1px solid #2c303a;
      border-bottom: none;
      border-radius: 10px 10px 0 0;
      box-shadow: none;
      margin: 0; padding: 0;
      font-size: 16px;
      font-weight: bold;
      opacity: 0.9;
    }
    button:active { background: #f2c14e; color: #14161a; }
    """
    prov = Gtk.CssProvider()
    prov.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.Window()
    win.set_decorated(False)
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.TOP)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)   # centred horizontally
    GtkLayerShell.set_exclusive_zone(win, -1)   # measure from the screen edge
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)
    GtkLayerShell.set_namespace(win, "pinet-panel-tab")

    btn = Gtk.Button()
    btn.set_size_request(72, 20)
    win.add(btn)
    # app: an app window is open; pulled: the tab has pulled the taskbar up over it
    state = {"app": None, "pulled": False, "timer": 0}

    def cancel_timer():
        if state["timer"]:
            GLib.source_remove(state["timer"])
            state["timer"] = 0

    def apply():
        if not state["app"]:                    # desktop: taskbar up, no tab needed
            cancel_timer()
            state["pulled"] = False
            set_autohide(False)
            win.hide()
        elif state["pulled"]:                   # app open, taskbar pulled up by the tab
            set_autohide(False)
            GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, PANEL_HEIGHT)
            btn.set_label("﹀")   # push it back down
            win.show_all()
        else:                                   # app open: taskbar tucked away
            cancel_timer()
            set_autohide(True)
            release_pointer()
            GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, 0)
            btn.set_label("︿")   # pull the taskbar up
            win.show_all()

    def push_down(*_):
        state["timer"] = 0
        state["pulled"] = False
        apply()
        return False

    def toggle(*_):
        if state["app"]:                        # on the desktop the taskbar is already up
            cancel_timer()
            state["pulled"] = not state["pulled"]
            if state["pulled"]:
                state["timer"] = GLib.timeout_add_seconds(SHOW_SECONDS, push_down)
            apply()
        return True

    def poll():
        now = app_open()
        if now != state["app"]:
            state["app"] = now
            state["pulled"] = False
            apply()
        return True

    def quit_showing(*_):
        cancel_timer()
        set_autohide(False)
        Gtk.main_quit()
        return False

    btn.connect("clicked", toggle)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, toggle)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, quit_showing)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, quit_showing)
    poll()
    GLib.timeout_add(POLL_MS, poll)
    Gtk.main()


if __name__ == "__main__":
    main()
