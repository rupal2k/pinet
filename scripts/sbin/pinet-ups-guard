#!/usr/bin/env python3
"""Shut the Pi down cleanly before the UPS HAT (D) runs flat, and arm the HAT
to boot it again once the charger is back.

What Waveshare's own demo does, as a service that runs headless:
  * on battery (not charging) with the cells below UPS_SHUTDOWN_V for
    UPS_SHUTDOWN_GRACE seconds -> warn, then power off. Plugging the charger
    in during the countdown cancels it. The warning goes to every terminal
    (wall) and to the e-ink dashboard, which shows a full-screen countdown
    while LOW_FLAG exists. The flag holds the power-off time on the
    monotonic clock, which both processes share and which never jumps (this
    RTC-less Pi's wall clock steps at boot), so the e-ink counts down to the
    same moment the guard acts on.
  * arm boot-on-power: 0x55 into register 0x01 of the HAT's MCU (0x2D). 30 s
    later it starts watching the charging port and pulls GPIO3 low when power
    returns, which boots a halted Pi. Waveshare: the Pi must power off right
    after this write. A shutdown can take longer than 30 s, so the guard only
    leaves ARM_MARK; the systemd-shutdown hook pinet-ups-arm writes the
    register as the very last step before power-off.

The default cutoff is 3.3 V, not Waveshare's 3.15 V: the HAT's boost
converter gets weaker as the cells run down, and this Pi browned out at
3.57 V once already.

    pinet-ups-guard            run (pinet-ups-guard.service)
    pinet-ups-guard --dry-run  same, but log instead of arming/powering off

The INA219 maths comes from /usr/local/bin/pinet-battery (the taskbar icon's
reader), loaded as a module so the numbers match everywhere.
"""
import importlib.machinery
import os
import signal
import subprocess
import sys
import time
import types

READER = os.environ.get("UPS_READER", "/usr/local/bin/pinet-battery")
SHUTDOWN_V = float(os.environ.get("UPS_SHUTDOWN_V", "3.3"))
GRACE = int(os.environ.get("UPS_SHUTDOWN_GRACE", "60"))
# tmpfs: a reboot can never leave a stale countdown behind.
LOW_FLAG = os.environ.get("UPS_LOW_FLAG", "/run/pinet-ups-low")
# Read by /usr/lib/systemd/system-shutdown/pinet-ups-arm (arms boot-on-power).
ARM_MARK = os.environ.get("UPS_ARM_MARK", "/run/pinet-ups-arm-boot")
INTERVAL = 2
RECOVER_V = 0.1      # hysteresis: once counting, only SHUTDOWN_V + this counts as recovered
CANCEL_READINGS = 2  # a lone odd reading (a load spike reversing the current) doesn't cancel


def load_reader(path=READER):
    loader = importlib.machinery.SourceFileLoader("pinet_battery", path)
    mod = types.ModuleType(loader.name)
    loader.exec_module(mod)
    return mod


def new_state():
    return {"deadline": None, "ok": 0}


def decide(state, volts, amps, reader, now):
    """One reading at monotonic time `now` -> action: None, "warn" (countdown
    starts; state["deadline"] = power-off time), "cancel" or "shutdown".

    The countdown is clock time, not a count of readings, so slow or failed
    reads can't stretch it past what the e-ink shows. Once counting it keeps
    running until the cells are really back (SHUTDOWN_V + RECOVER_V, or the
    charger) for CANCEL_READINGS in a row.

    The raw terminal voltage is compared, not the rest-voltage the percent
    uses: under load it reads lower, so the cutoff errs early -- and the
    brownouts it guards against follow the terminal voltage."""
    if volts < 2.5:                      # implausible: a bad read, not a flat cell
        return None
    cell_v = volts / (2 if volts > 5.0 else 1)   # 2 cells in series: per cell, like percent()
    on_battery = reader.power_state(amps) == "battery"
    counting = state["deadline"] is not None
    if on_battery and cell_v < SHUTDOWN_V + (RECOVER_V if counting else 0):
        state["ok"] = 0
        if not counting:
            state["deadline"] = now + GRACE
            return "warn"
        return "shutdown" if now >= state["deadline"] else None
    if counting:
        state["ok"] += 1
        if state["ok"] >= CANCEL_READINGS:
            state.update(new_state())
            return "cancel"
    return None


def tell(msg):
    """Journal and every terminal, best effort."""
    print(f"pinet-ups-guard: {msg}", flush=True)
    subprocess.run(["wall", msg], stderr=subprocess.DEVNULL, check=False)


ETH_SHARE = os.environ.get("ETH_SHARE_BIN", "/usr/local/sbin/eth-share")


def shed_eth_share():
    """Stop Ethernet sharing if it's on: routing is extra draw the failing
    battery can't spare. Best effort -- never let it block the shutdown path."""
    if not os.path.exists(ETH_SHARE):
        return
    try:
        subprocess.run([ETH_SHARE, "stop"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=25, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def set_countdown(deadline):
    """Tell the e-ink when power-off is due, on the monotonic clock
    (None: countdown over)."""
    try:
        if deadline is None:
            os.unlink(LOW_FLAG)
        else:
            tmp = LOW_FLAG + ".tmp"
            with open(tmp, "w") as f:
                f.write(f"{deadline:.1f}\n")
            os.chmod(tmp, 0o644)
            os.replace(tmp, LOW_FLAG)
    except OSError:
        pass


def power_off(dry_run):
    if dry_run:
        print("pinet-ups-guard: dry run -- would arm boot-on-power and power off", flush=True)
        return
    try:
        open(ARM_MARK, "w").close()     # pinet-ups-arm writes the MCU at the very end
    except OSError as e:
        print(f"pinet-ups-guard: could not mark boot-on-power ({e}); power off anyway", flush=True)
    subprocess.run(["systemctl", "poweroff"], check=False)


def main():
    dry_run = sys.argv[1:] == ["--dry-run"]
    reader = load_reader()
    from smbus2 import SMBus
    bus = SMBus(reader.BUS)
    addr = reader.find(bus)
    if addr is None:
        sys.exit("pinet-ups-guard: no UPS HAT on I2C")
    print(f"pinet-ups-guard: watching {addr:#x}, power off below {SHUTDOWN_V} V "
          f"on battery for {GRACE} s", flush=True)
    set_countdown(None)   # a guard restarted mid-countdown starts clean

    def stop(signum, frame):
        set_countdown(None)   # never leave the e-ink on a countdown nobody runs
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    state = new_state()
    while True:
        try:
            volts, amps = reader.read(bus, addr)
        except OSError:
            time.sleep(INTERVAL)
            continue
        action = decide(state, volts, amps, reader, time.monotonic())
        if action == "warn":
            set_countdown(state["deadline"])
            shed_eth_share()   # drop the routing load to buy the countdown time
            tell(f"Battery low ({volts:.2f} V). Shutting down in {GRACE} s -- plug in the charger to stop it.")
        elif action == "cancel":
            set_countdown(None)
            if reader.power_state(amps) == "battery":
                tell("Battery recovered -- shutdown cancelled.")
            else:
                tell("Charger connected -- shutdown cancelled.")
        elif action == "shutdown":
            tell("Battery flat -- shutting down now. It will start again when the charger is plugged in.")
            power_off(dry_run)
            if dry_run:
                set_countdown(None)
                state = new_state()
            else:
                return
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
