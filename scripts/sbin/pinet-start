#!/bin/bash
# Start the PINET hotspot (wlan0 AP) + board/server on demand.
# PINET is NOT enabled at boot; use this to bring it up, pinet-stop to take it down.
set -u
[ "$(id -u)" -eq 0 ] || { echo "Run with sudo: sudo pinet-start" >&2; exit 1; }
rm -f /run/pinet-stopped  # see pinet-stop
failed=0
for u in pinet-ap-network.service hostapd.service dnsmasq.service pinet-board.service stunnel@pinet-board.service; do
    if systemctl start "$u"; then echo "started $u"; else echo "FAILED $u"; failed=1; fi
done
if [ "$failed" -eq 0 ]; then
    echo "PINET is up: SSID PINET @ 10.10.10.1"
else
    echo "PINET is only partly up -- see: systemctl --failed" >&2
fi
exit "$failed"
