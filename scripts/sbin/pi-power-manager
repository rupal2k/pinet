#!/usr/bin/env python3
"""Pi power manager: sheds power-hungry services while a DSI kiosk is open.

This Pi 3B's supply sags under load; stacking a browser on top of the PINET
hotspot, VNC, Bluetooth and the slideshow has stalled the SD card and reset
the board. While a kiosk is open (an entry in KIOSK_DIR, one per kiosk, or the
single KIOSK_FLAG, see kiosk_open()), those services are stopped (only the
ones that were running) and "kiosk" is written to MODE so the kiosk launcher
knows it may start the browser. When the flag goes away they come back one
at a time (MODE "restoring", then "normal"), pausing while the firmware reports live under-voltage so restart
inrush doesn't land on a sagging rail.

Kept running on purpose: the e-ink dashboard (shows KIOSK MODE ON), wlan1
internet, sshd, and rpi-connect's remote-access daemon.

Pentest power mode (kali-power-shed) stops mostly the same units with its own
state, so the two hand units to each other instead of restarting them under
the other's feet: a kiosk closing during pentest mode appends what pentest
mode keeps down to /run/pentest-shed.list (wifi-pentest-stop restores it), and
pentest mode ending during a kiosk leaves its units in HANDOFF for this to
restore after the kiosk. Both sides decide and write under LOCK, so neither
can read the other's list mid-update or restore while the other is shedding.
"""
import fcntl
import json
import subprocess
import time
from pathlib import Path

KIOSK_FLAG = Path("/run/user/1000/kiosk-mode")
KIOSK_DIR = Path("/run/user/1000/kiosk-mode.d")  # dsi-kiosk.sh: one entry per kiosk
RUN_DIR = Path("/run/pi-power-manager")
STATE = RUN_DIR / "stopped.json"
MODE = RUN_DIR / "mode"
UV_STATUS = RUN_DIR / "under-voltage"   # "1"/"0" from pwr_low_pin(), for the e-ink
HANDOFF = RUN_DIR / "handoff.list"  # "sys:unit"/"user:unit" from kali-power-shed
LOCK = Path("/run/power-shed.lock")  # shared with kali-power-shed
PENTEST_FLAG = Path("/run/pentest-mode")
PENTEST_STATE = Path("/run/pentest-shed.list")
# Set by pinet-stop, cleared by pinet-start: a deliberate stop sticks, so
# PINET units shed before it are left down instead of restored.
PINET_STOPPED = Path("/run/pinet-stopped")
PINET_UNITS = {"pinet-board.service", "dnsmasq.service", "hostapd.service"}
# The kernel's live GPIO view (debugfs, root-only, auto-mounted); see
# pwr_low_pin(). The answer is published to UV_STATUS for the e-ink.
GPIO_DEBUG = Path("/sys/kernel/debug/gpio")
POLL_SECONDS = 2
RESTORE_GAP_SECONDS = 2
VOLTAGE_WAIT_MAX_SECONDS = 5

# Stopped in this order, restored in reverse (hostapd before dnsmasq).
SHED_UNITS = [
    ("user", "dsi-photo-frame.service"),
    ("user", "dsi-photo-sync.timer"),
    ("user", "dsi-idle-sleep.service"),
    ("user", "rpi-connect-wayvnc.service"),
    ("system", "pinet-board.service"),
    ("system", "dnsmasq.service"),
    ("system", "hostapd.service"),
    ("system", "wayvnc.service"),
    ("system", "bluetooth.service"),
]
# D-Bus activated (dbus-org.bluez.service alias): the panel's bluetooth applet
# restarts a plain-stopped bluetoothd within ~0.1s, so these are runtime-masked
# while shed and unmasked just before restore (a reboot also clears the mask).
MASK_WHILE_SHED = {"bluetooth.service"}
# What pentest power mode keeps down (kali-power-shed's USER_UNITS/SYS_UNITS --
# keep in sync). The rest (photo-sync, idle-sleep) is restored as usual.
PENTEST_UNITS = {
    ("user", "dsi-photo-frame.service"), ("user", "rpi-connect-wayvnc.service"),
    ("system", "pinet-board.service"),
    ("system", "dnsmasq.service"), ("system", "hostapd.service"),
    ("system", "wayvnc.service"), ("system", "bluetooth.service"),
}
USER_CMD = ["runuser", "-u", "rupal", "--", "env", "XDG_RUNTIME_DIR=/run/user/1000",
            "WAYLAND_DISPLAY=wayland-0", "systemctl", "--user"]


def systemctl(scope, *args):
    cmd = (USER_CMD if scope == "user" else ["systemctl"]) + list(args)
    return subprocess.run(cmd, capture_output=True, text=True).returncode


def pwr_low_pin():
    """True while the Pi 3B's PWR_LOW_N line is low, i.e. under-voltage.

    This Pi runs avoid_warnings=2 in config.txt (full CPU clock), which
    zeroes get_throttled's under-voltage bits; the line itself is still
    reported. Read from debugfs because the PWR LED driver holds the line
    (gpioget: busy) and /sys/class/leds/PWR/brightness is a cached 0, not
    the pin. Checked 2026-09-27 against the firmware flag with
    avoid_warnings off: line low in 20/20 samples, flag set in 20/20.
    None when it can't be read (no debugfs, not a Pi 3B)."""
    try:
        for line in GPIO_DEBUG.read_text().splitlines():
            if "PWR_LOW_N" in line:
                return " lo" in line
    except OSError:
        pass
    return None


def publish_under_voltage():
    """Share the pin's answer with the e-ink dashboard, which can't read
    debugfs: "1"/"0", rewritten every poll so a stale file means we're gone."""
    uv = pwr_low_pin()
    if uv is None:
        UV_STATUS.unlink(missing_ok=True)
        return
    tmp = UV_STATUS.with_suffix(".tmp")
    tmp.write_text("1\n" if uv else "0\n")
    tmp.replace(UV_STATUS)


def under_voltage_now():
    if pwr_low_pin():
        return True
    try:
        out = subprocess.run(["vcgencmd", "get_throttled"], capture_output=True, text=True).stdout
        return bool(int(out.strip().split("=")[1], 16) & 0x1)
    except (OSError, ValueError, IndexError):
        return False


def kiosk_open():
    """Any kiosk entry left, or the single flag (the dashboard's copy, and what
    older dsi-kiosk.sh wrote): one kiosk closing mustn't unshed another."""
    try:
        if any(KIOSK_DIR.iterdir()):
            return True
    except OSError:
        pass
    return KIOSK_FLAG.exists()


def load_stopped():
    """What's shed, in SHED_UNITS order; entries that aren't SHED_UNITS are
    ignored. No file means nothing shed, but an unreadable one means we can't
    tell, so assume everything was: starting a unit that was already off beats
    leaving hostapd down."""
    try:
        data = json.loads(STATE.read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError):
        data = None
    if not isinstance(data, list):
        print(f"{STATE} unreadable -- treating every shed unit as stopped", flush=True)
        return list(SHED_UNITS)
    return [u for u in SHED_UNITS if any(isinstance(x, list) and tuple(x) == u for x in data)]


def save_stopped(stopped):
    tmp = STATE.with_suffix(".tmp")  # never leave a half-written STATE
    tmp.write_text(json.dumps(stopped))
    tmp.replace(STATE)


class shed_lock:
    """flock on LOCK -- kali-power-shed takes the same one (flock 9)."""
    def __enter__(self):
        self.f = open(LOCK, "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        self.f.close()


def as_line(scope, unit):
    return f"{'sys' if scope == 'system' else 'user'}:{unit}"


def take_handoff(stopped):
    """Merge in what kali-power-shed left down for us when pentest mode ended."""
    try:
        lines = HANDOFF.read_text().split()
    except OSError:
        return stopped
    HANDOFF.unlink(missing_ok=True)
    for scope, _, unit in (line.partition(":") for line in lines):
        item = ("system" if scope == "sys" else "user", unit)
        if item in SHED_UNITS and item not in stopped:
            stopped.append(item)
    stopped.sort(key=SHED_UNITS.index)
    return stopped


def hand_to_pentest(scope, unit):
    """Add a unit to kali-power-shed's list, kept in its shed order (it
    restores the file bottom-up, so hostapd still comes back before dnsmasq)."""
    order = [as_line(*u) for u in SHED_UNITS]
    try:
        lines = PENTEST_STATE.read_text().split()
    except OSError:
        lines = []
    if as_line(scope, unit) not in lines:
        lines.append(as_line(scope, unit))
    lines.sort(key=lambda l: order.index(l) if l in order else -1)
    PENTEST_STATE.write_text("".join(l + "\n" for l in lines))


def shed():
    with shed_lock():
        # Merge with anything still stopped from an interrupted restore.
        stopped = take_handoff(load_stopped())
        # Listed units are checked too: the list may be a guess (see
        # load_stopped) or one may have been started by hand since.
        for scope, unit in SHED_UNITS:
            if systemctl(scope, "is-active", "--quiet", unit) == 0:
                if unit in MASK_WHILE_SHED:
                    systemctl(scope, "mask", "--runtime", unit)
                systemctl(scope, "stop", unit)
                if (scope, unit) not in stopped:
                    stopped.append((scope, unit))
        stopped.sort(key=SHED_UNITS.index)
        save_stopped(stopped)
        MODE.write_text("kiosk\n")
    print(f"kiosk mode: shed {', '.join(u for _, u in stopped) or 'nothing'}", flush=True)


def restore():
    """Returns False if a kiosk reopened mid-restore (the rest stays stopped)."""
    while True:
        with shed_lock():
            stopped = take_handoff(load_stopped())
            if kiosk_open():
                save_stopped(stopped)
                return False
            if not stopped:
                STATE.unlink(missing_ok=True)
                MODE.write_text("normal\n")
                return True
            # Not "kiosk" any more: a kiosk reopening now must wait for the
            # re-shed, and kali-power-shed hands its units to us, not starts them.
            MODE.write_text("restoring\n")
            scope, unit = stopped.pop()
            started = False
            if unit in PINET_UNITS and PINET_STOPPED.exists():
                msg = f"left {unit} down (pinet-stop)"
            elif (scope, unit) in PENTEST_UNITS and PENTEST_FLAG.exists():
                hand_to_pentest(scope, unit)
                msg = f"left {unit} to pentest mode (wifi-pentest-stop restores it)"
            else:
                waited = 0
                while under_voltage_now() and waited < VOLTAGE_WAIT_MAX_SECONDS:
                    time.sleep(1)
                    waited += 1
                if unit in MASK_WHILE_SHED:
                    systemctl(scope, "unmask", "--runtime", unit)
                # --no-block: some units have their own startup delays (wayvnc
                # sleeps 50s from the boot staggering); the gap below still
                # paces the starts.
                systemctl(scope, "start", "--no-block", unit)
                started = True
                note = f" after waiting {waited}s for voltage" if waited else ""
                msg = f"restored {unit}{note}"
            save_stopped(stopped)
        print(msg, flush=True)
        if started:
            time.sleep(RESTORE_GAP_SECONDS)


def main():
    RUN_DIR.mkdir(exist_ok=True)
    kiosk = False
    if (STATE.exists() or HANDOFF.exists()) and not kiosk_open():
        restore()  # manager restarted while services were shed
    MODE.write_text("normal\n" if not STATE.exists() else "restoring\n")
    while True:
        try:
            publish_under_voltage()
        except OSError:
            pass
        want_kiosk = kiosk_open()
        if want_kiosk and not kiosk:
            shed()
            kiosk = True
        # STATE left over: a restore cut short by a kiosk that closed again
        # before the next poll -- finish it rather than leave units down.
        elif not want_kiosk and (kiosk or STATE.exists() or HANDOFF.exists()):
            restore()
            kiosk = False
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
