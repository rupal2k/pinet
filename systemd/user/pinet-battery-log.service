[Unit]
Description=UPS HAT battery calibration log (one line a minute)
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/pinet-battery --log %h/.local/share/pinet-battery/discharge.csv
# No HAT (or I2C off) exits non-zero; keep looking without spinning.
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
