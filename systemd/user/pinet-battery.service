[Unit]
Description=UPS HAT battery level in the taskbar tray
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/pinet-battery
# No HAT (or I2C off) exits non-zero; keep looking without spinning.
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
