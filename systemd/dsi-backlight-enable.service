[Unit]
Description=Enable DSI screen last: after lightdm/wayvnc settle and the e-ink dashboard is live
After=lightdm.service wayvnc.service pi-eink-dashboard.service
Wants=lightdm.service

[Service]
Type=oneshot
TimeoutStartSec=360
ExecStart=/usr/local/bin/dsi-boot-enable.sh

[Install]
WantedBy=graphical.target
