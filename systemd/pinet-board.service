[Unit]
Description=PINET anonymous message board + file drop
After=network.target hostapd.service dnsmasq.service

[Service]
Type=simple
User=pinet-board
Group=pinet-board
WorkingDirectory=/opt/pinet-board
# TMPDIR is critical, not cosmetic: /tmp on this Pi is a 463MB RAM-backed
# tmpfs, and Werkzeug spools large multipart uploads to a temp file
# before the app ever sees them. Without this, any upload approaching
# the 1GB cap fails well before reaching app.py's own disk-space check.
Environment=TMPDIR=/mnt/pinet-media/tmp
ExecStart=/usr/bin/python3 /opt/pinet-board/app.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Deliberately no CapabilityBoundingSet= override -- see the
# pinet-captive-portal vault note on why that broke sudo for the earlier
# bridge feature. This service doesn't need sudo at all, but keeping the
# bounding set at its default avoids the same class of mistake regardless.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
