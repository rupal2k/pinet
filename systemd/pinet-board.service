[Unit]
Description=PINET anonymous message board + file drop
After=network.target hostapd.service dnsmasq.service mnt-pinet\x2dmedia.mount
# mnt-pinet\x2dmedia.mount: wait for the LUKS USB before starting — /mnt/pinet-media/uploads
# and /mnt/pinet-media/tmp must exist before gunicorn boots or the first start crashes.

[Service]
Type=simple
User=pinet-board
Group=pinet-board
WorkingDirectory=/opt/pinet-board
# TMPDIR is critical, not cosmetic: /tmp on this Pi is a 463MB RAM-backed
# tmpfs, and Werkzeug spools large multipart uploads to a temp file
# before the app ever sees them. Without this, any upload approaching
# the 1GB cap fails well before reaching app.py's own disk-space check.
Environment=TMPDIR=/mnt/pinet-media/tmp
# The app needs the LUKS drive; until the PIN unlocks it, fail this cheap check
# and retry instead of crash-looping gunicorn.
ExecStartPre=/usr/bin/mountpoint -q /mnt/pinet-media
ExecStart=/usr/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:443 \
    --certfile /etc/pinet-board/tls-fullchain.pem \
    --keyfile /etc/pinet-board/tls.key \
    --timeout 30 \
    --keep-alive 5 \
    app:app
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Deliberately no CapabilityBoundingSet= override -- see the
# pinet-captive-portal vault note on why that broke sudo for the earlier
# bridge feature. This service doesn't need sudo at all, but keeping the
# bounding set at its default avoids the same class of mistake regardless.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
