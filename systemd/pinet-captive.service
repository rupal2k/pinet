[Unit]
Description=PINET captive-portal HTTP redirect (port 80)
After=network.target pinet-board.service

[Service]
Type=simple
User=pinet-board
Group=pinet-board
WorkingDirectory=/opt/pinet-board
Environment=TMPDIR=/mnt/pinet-media/tmp
ExecStart=/usr/bin/gunicorn \
    --workers 1 \
    --bind 0.0.0.0:80 \
    --timeout 10 \
    --keep-alive 2 \
    app:app
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
