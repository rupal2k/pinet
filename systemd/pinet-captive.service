[Unit]
Description=PINET captive-portal HTTP redirect (port 80)
After=network.target pinet-board.service

[Service]
Type=simple
User=pinet-board
Group=pinet-board
WorkingDirectory=/opt/pinet-board
Environment=TMPDIR=/mnt/pinet-media/tmp
# The app needs the LUKS drive; until the PIN unlocks it, fail this cheap check
# and retry instead of crash-looping gunicorn.
ExecStartPre=/usr/bin/mountpoint -q /mnt/pinet-media
ExecStart=/usr/bin/gunicorn \
    --workers 1 \
    --bind 0.0.0.0:80 \
    --timeout 10 \
    --keep-alive 2 \
    app:app
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
