[Desktop Entry]
Version=1.0
Type=Application
Name=PINET Browser
GenericName=Web Browser
Comment=Lightweight touch browser for the PINET touchscreen
Icon=pinet-browser
Exec=/usr/local/bin/pinet-browser %u
Terminal=false
Categories=Network;WebBrowser;GTK;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=pinet-browser
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/local/bin/pinet-browser
