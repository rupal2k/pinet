border.width: 2

window.active.title.bg.color: #1e2128
window.active.label.text.color: #eef0f3
window.active.border.color: #f2c14e
window.active.button.unpressed.image.color: #eef0f3

window.inactive.title.bg.color: #14161a
window.inactive.label.text.color: #9198a3
window.inactive.border.color: #2c303a
window.inactive.button.unpressed.image.color: #9198a3

# Shadows: labwc's 60/40 defaults fill a lot of pixels for a VideoCore IV at
# 800x480. 22/12 reads as depth and costs a fraction of it.
window.active.shadow.size: 22
window.inactive.shadow.size: 12
window.active.shadow.color: #00000070
window.inactive.shadow.color: #00000040

# Circular titlebar button hover, as on macOS: width == height, radius half.
window.button.width: 22
window.button.height: 22
window.button.hover.bg.corner-radius: 11
